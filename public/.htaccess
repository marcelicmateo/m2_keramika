# Apache on the production hosting (kuhada.net / Plesk). GitHub Pages ignores this file.

ErrorDocument 404 /404.html
AddType "text/csv; charset=utf-8" .csv

RewriteEngine On

# Always https://m2-keramika.hr (no http, no www).
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://m2-keramika.hr%{REQUEST_URI} [L,R=301]

# Old WordPress link to the price list.
RewriteRule ^wp-content/uploads/2026/09/Obrt_JerolimaMise8_1_20092026_0730-List-1\.csv$ /cjenik.csv [L,R=301]

# Compress text files (HTML, CSS, JS, SVG, XML, CSV).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript image/svg+xml text/xml application/xml text/csv text/plain
</IfModule>

<IfModule mod_headers.c>
  # Pages always revalidate, so edits show at once; Astro's hashed files never change.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
