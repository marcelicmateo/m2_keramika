---
import { getEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import hero from '../assets/bazen.jpg';
import { url } from '../url';
import DesignBar from '../components/DesignBar.astro';

interface Props {
  title?: string;
}
const naslov = 'M² Keramika – keramičar Zadar | postavljanje pločica i hidroizolacija';
const { title = naslov } = Astro.props;
const stranica = (await getEntry('stranica', 'stranica'))!.data;
const og = await getImage({ src: hero, width: 1200, format: 'jpg' });
const ogUrl = new URL(og.src, Astro.site).href;
const noindex = Boolean(process.env.DEV_SITE);
---
<!doctype html>
<html lang="hr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={stranica.seo_opis} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="hr_HR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={stranica.seo_opis} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
  </head>
  <body>
    <DesignBar />
    <div class="page">
      <slot />
    </div>
  </body>
</html>

<style>
  /* The baseline header is absolutely positioned; this keeps it below the design bar. */
  .page { position: relative; }
</style>
