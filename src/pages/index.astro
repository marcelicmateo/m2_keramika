---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Intro from '../components/Intro.astro';
import Services from '../components/Services.astro';
import Projects from '../components/Projects.astro';
import PriceList from '../components/PriceList.astro';
import Footer from '../components/Footer.astro';

const stranica = (await getEntry('stranica', 'stranica'))!.data;
const { usluge } = (await getEntry('usluge', 'usluge'))!.data;
const galerija = (await getEntry('galerija', 'galerija'))!.data;
const cjenik = (await getEntry('cjenik', 'cjenik'))!.data;
---
<Base>
  <Header telefon={stranica.telefon} email={stranica.email} />
  <main>
    <Hero slogan={stranica.slogan} />
    <Intro naslov={stranica.uvod.naslov} tekst={stranica.uvod.tekst} />
    <Services usluge={usluge} />
    <Projects
      kvaliteta={stranica.kvaliteta}
      projektiNaslov={stranica.projekti_naslov}
      slike={galerija.slike}
      prijePoslije={galerija.prije_poslije}
    />
    <PriceList napomena={cjenik.napomena} stavke={cjenik.stavke} />
  </main>
  <Footer
    telefon={stranica.telefon}
    email={stranica.email}
    vlasnik={stranica.vlasnik}
    adresa={stranica.adresa}
    kontaktTekst={stranica.kontakt_tekst}
  />
</Base>
