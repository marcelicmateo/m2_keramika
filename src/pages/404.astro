---
import '../styles/global.css';
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Ornament from '../components/Ornament.astro';
import { url } from '../url';
---
<Base title="Stranica nije pronađena – M² Keramika">
  <main class="section wrap center">
    <Ornament />
    <h1>Stranica nije pronađena</h1>
    <p>Tražena stranica ne postoji ili je premještena.</p>
    <Button href={url()}>Natrag na početnu</Button>
  </main>
</Base>

<style>
  main { min-height: 70svh; display: grid; place-content: center; justify-items: center; gap: var(--space-5); }
  h1 { font-size: var(--fs-h2); }
</style>
