---
// 07 · Art Deco: black, gold and deep teal; sunbursts, fans and symmetric line ornaments. Poiret One + Jost.
import { getEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Photo from '../../designs/07/Photo.astro';
import Lightbox from '../../designs/07/Lightbox.astro';
import hero from '../../assets/bazen.jpg';
import { url } from '../../url';
import '../../designs/07/style.css';

const s = (await getEntry('stranica', 'stranica'))!.data;
const { usluge } = (await getEntry('usluge', 'usluge'))!.data;
const galerija = (await getEntry('galerija', 'galerija'))!.data;
const cjenik = (await getEntry('cjenik', 'cjenik'))!.data;

const tel = `tel:${s.telefon.replace(/\s/g, '')}`;
const grad = s.adresa.split(',').pop()!.trim();
const maps = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(s.adresa);
const nb = (t: string) => t.replace(/ (?=(m[²¹]|cm|€)(?!\p{L}))/gu, ' ');
const druga = cjenik.naslov_druga_cijena;
const rim = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII'];
// Sunburst: rays fanning up from the bottom centre of a 1200 × 600 box.
const rays = Array.from({ length: 37 }, (_, i) => {
  const a = (Math.PI * i) / 36;
  return { x: (600 - Math.cos(a) * 1300).toFixed(1), y: (600 - Math.sin(a) * 1300).toFixed(1) };
});
---
<Base>
  <header class="top">
    <div class="wrap top__in">
      <nav class="top__nav" aria-label="Sekcije">
        <a href="#usluge">Usluge</a><a href="#radovi">Radovi</a><a href="#cjenik">Cjenik</a><a href="#kontakt">Kontakt</a>
      </nav>
      <a class="mono" href="#vrh" aria-label={s.naziv}><span aria-hidden="true">M²</span></a>
      <a class="top__tel" href={tel}><span class="top__lbl">Nazovite</span> <span class="top__num">{s.telefon}</span></a>
    </div>
  </header>

  <main id="vrh">
    <section class="hero" aria-labelledby="h1">
      <svg class="hero__burst" viewBox="0 0 1200 600" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
        <g stroke="currentColor" stroke-width="1">
          {rays.map((r) => <line x1="600" y1="600" x2={r.x} y2={r.y} />)}
        </g>
        <g fill="none" stroke="currentColor">
          {[110, 150, 190].map((r) => <circle cx="600" cy="600" r={r} />)}
        </g>
      </svg>
      <div class="hero__frame">
        <p class="eyebrow">{s.naziv} <span aria-hidden="true">◆</span> {grad}</p>
        <h1 id="h1">{s.slogan}</h1>
        <div class="orn" aria-hidden="true"><span></span></div>
        <a class="btn btn--gold" href={tel}><span class="btn__lbl">Nazovite</span>{s.telefon}</a>
        <a class="hero__mail" href={`mailto:${s.email}`}>{s.email}</a>
      </div>
    </section>

    <section class="intro wrap" aria-labelledby="uvod">
      <div class="intro__pic">
        <Picture src={hero} alt="" formats={['avif', 'webp']} widths={[400, 800, 1200]} sizes="(min-width: 56rem) 34vw, 86vw" />
      </div>
      <div class="intro__text">
        <p class="eyebrow">Uvod</p>
        <h2 id="uvod">{s.uvod.naslov}</h2>
        <p>{s.uvod.tekst}</p>
      </div>
    </section>

    <section class="services wrap" id="usluge" aria-labelledby="usluge-h">
      <div class="head">
        <div class="orn" aria-hidden="true"><span></span></div>
        <h2 id="usluge-h">Usluge</h2>
      </div>
      <div class="panels">
        {usluge.map((u, i) => (
          <article class="panel">
            <svg class="fan" viewBox="0 0 120 60" aria-hidden="true">
              <g fill="none" stroke="currentColor">
                <path d="M10 60a50 50 0 0 1 100 0M24 60a36 36 0 0 1 72 0M38 60a22 22 0 0 1 44 0" />
                <path d="M60 60V10M60 60 25 25M60 60l35-35M60 60 14 41M60 60l46-19" />
              </g>
            </svg>
            <p class="panel__n">{rim[i] ?? i + 1}</p>
            <h3>{u.naslov}</h3>
            <p class="panel__hi">{u.istaknuto}</p>
            <p>{u.opis}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="quality" aria-labelledby="kvaliteta">
      <div class="wrap quality__in">
        <div class="orn" aria-hidden="true"><span></span></div>
        <h2 id="kvaliteta">{s.kvaliteta.naslov}</h2>
        <p>{s.kvaliteta.tekst}</p>
      </div>
    </section>

    <section class="works wrap" id="radovi" aria-labelledby="radovi-h">
      <div class="head">
        <div class="orn" aria-hidden="true"><span></span></div>
        <h2 id="radovi-h">{s.projekti_naslov}</h2>
      </div>
      <ul class="gal" role="list" data-group>
        {galerija.slike.map((p) => (
          <li>
            <Photo class="ph" src={p.slika} alt={p.opis} sizes="(min-width: 56rem) 22vw, 44vw" />
            <p>{p.opis}</p>
          </li>
        ))}
      </ul>

      {galerija.prije_poslije.map((set) => {
        const koraci = [
          { label: 'Prije', src: set.prije },
          ...(set.tijekom ? [{ label: 'Tijekom', src: set.tijekom }] : []),
          { label: 'Poslije', src: set.poslije },
        ];
        return (
          <figure class="set" data-group>
            <figcaption><h3>{set.naslov}</h3><p>{set.opis}</p></figcaption>
            <ol class="set__row" role="list">
              {koraci.map((k) => (
                <li>
                  <p class="set__label">{k.label}</p>
                  <Photo class="ph" src={k.src} alt={`${k.label} – ${set.opis}`} sizes="(min-width: 56rem) 24vw, 30vw" />
                </li>
              ))}
            </ol>
          </figure>
        );
      })}
    </section>

    <section class="prices wrap" id="cjenik" aria-labelledby="cjenik-h">
      <div class="menu">
        <h2 id="cjenik-h">Cjenik<span aria-hidden="true">*</span></h2>
        <div class="orn" aria-hidden="true"><span></span></div>
        <table class="pl">
          <caption class="vh">Cjenik keramičarskih usluga</caption>
          <thead>
            <tr><th scope="col">Usluga</th><th scope="col">Jedinica</th><th scope="col" class="num">{cjenik.naslov_cijena}</th>{druga && <th scope="col" class="num">{druga}</th>}</tr>
          </thead>
          <tbody>
            {cjenik.stavke.map((r) => (
              <tr>
                <th scope="row"><span>{nb(r.usluga)}</span></th>
                <td class="unit">{r.jedinica}</td>
                <td class="num" data-label={cjenik.naslov_cijena}>{nb(r.cijena)}</td>
                {druga && <td class="num" data-label={druga}>{nb(r.druga_cijena ?? '–')}</td>}
              </tr>
            ))}
          </tbody>
        </table>
        <p class="note">*{cjenik.napomena}</p>
        <a class="btn btn--line" href={url('cjenik.csv')} download="cjenik-m2-keramika.csv">Preuzmite cjenik (CSV)</a>
      </div>
    </section>
  </main>

  <footer class="foot" id="kontakt" aria-labelledby="kontakt-h">
    <svg class="foot__sun" viewBox="0 0 1200 600" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
      <g stroke="currentColor">{rays.map((r) => <line x1="600" y1="600" x2={r.x} y2={r.y} />)}</g>
    </svg>
    <div class="wrap foot__in">
      <div class="orn" aria-hidden="true"><span></span></div>
      <h2 id="kontakt-h">Kontakt</h2>
      <p class="foot__txt">{s.kontakt_tekst.trim()}</p>
      <a class="foot__tel" href={tel}>{s.telefon}</a>
      <ul class="foot__cols" role="list">
        <li><span class="eyebrow">E-mail</span><a href={`mailto:${s.email}`}>{s.email}</a></li>
        <li><span class="eyebrow">Vlasnik</span>{s.vlasnik}</li>
        <li><span class="eyebrow">Adresa</span><a href={maps} target="_blank" rel="noopener">{s.adresa}</a></li>
      </ul>
      <p class="foot__copy">© {new Date().getFullYear()} {s.naziv}</p>
    </div>
  </footer>
  <Lightbox />
</Base>
