---
// 19 · Priča u kadrovima — the work told as a film: full-screen scenes, prije → tijekom → poslije wiped in on scroll.
import { getEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Pic from '../../designs/19/Pic.astro';
import Lightbox from '../../designs/19/Lightbox.astro';
import bazen from '../../assets/bazen.jpg';
import { url } from '../../url';
import '../../designs/19/style.css';

const s = (await getEntry('stranica', 'stranica'))!.data;
const { usluge } = (await getEntry('usluge', 'usluge'))!.data;
const galerija = (await getEntry('galerija', 'galerija'))!.data;
const cjenik = (await getEntry('cjenik', 'cjenik'))!.data;
const tel = `tel:${s.telefon.replace(/\s/g, '')}`;
const maps = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(s.adresa);
const nb = (t: string) => t.replace(/ (?=(m[²¹]|cm|€)(?!\p{L}))/gu, ' ');
const druga = cjenik.naslov_druga_cijena;
const two = (n: number) => String(n).padStart(2, '0');
const tall = '(min-width: 56rem) 60vh, 100vw';
---
<Base>
  <div class="film">
    <header class="top">
      <a class="brand" href={url()}>{s.naziv}</a>
      <a class="call" href={tel}><Icon name="phone" /><span>Nazovite</span></a>
      <span class="progress" aria-hidden="true"></span>
    </header>

    <main>
      <section class="scene hero">
        <Picture class="hero__bg" src={bazen} alt="" formats={['avif', 'webp']} widths={[400, 800, 1200, 1600]} sizes="100vw" loading="eager" />
        <div class="hero__text">
          <p class="slate">{s.naziv}</p>
          <h1>{s.slogan}</h1>
          <p class="hero__contact">
            <a class="tel" href={tel}>{s.telefon}</a>
            <a href={`mailto:${s.email}`}>{s.email}</a>
          </p>
        </div>
        <a class="cue" href="#uvod">Priča počinje <span aria-hidden="true">↓</span></a>
      </section>

      <section class="scene scene--text" id="uvod">
        <p class="slate reveal">01 — Uvod</p>
        <h2 class="big reveal">{s.uvod.naslov}</h2>
        <p class="lead reveal">{s.uvod.tekst}</p>
      </section>

      {galerija.prije_poslije.map((set, n) => {
        const koraci = [
          { label: 'Prije', src: set.prije },
          ...(set.tijekom ? [{ label: 'U procesu', src: set.tijekom }] : []),
          { label: 'Poslije', src: set.poslije },
        ];
        const seg = 100 / (koraci.length - 1);
        return (
          <>
            <section class="scene scene--text chapter">
              <p class="slate reveal">{two(n + 2)} — Prije, tijekom, poslije</p>
              <h2 class="huge reveal">{set.naslov}</h2>
              <p class="lead reveal">{set.opis}</p>
            </section>
            <section class="story" style={`--n: ${koraci.length}`} aria-label={set.naslov} data-group>
              <div class="story__frame">
                {koraci.map((k, i) => (
                  <figure class="shot" style={i ? `--a: ${(seg * (i - 1) + seg * 0.2).toFixed(1)}%; --b: ${(seg * (i - 1) + seg * 0.8).toFixed(1)}%` : undefined}>
                    <Pic class="shot__img" src={k.src} alt={`${k.label} – ${set.opis}`} sizes={tall} widths={[400, 800, 1200, 1600]} />
                    <figcaption>
                      <span class="shot__no">{two(i + 1)} / {two(koraci.length)}</span>
                      <span class="shot__label">{k.label}</span>
                    </figcaption>
                  </figure>
                ))}
              </div>
            </section>
          </>
        );
      })}

      <section class="scene scene--text usluge" id="usluge" aria-labelledby="usluge-h">
        <p class="slate reveal">{two(galerija.prije_poslije.length + 2)} — Što radimo</p>
        <h2 id="usluge-h" class="big reveal">Usluge</h2>
        <ol class="services" role="list">
          {usluge.map((u, i) => (
            <li class="reveal">
              <span class="services__no" aria-hidden="true">{two(i + 1)}</span>
              <h3>{u.naslov}</h3>
              <p class="services__hi">{u.istaknuto}</p>
              <p>{u.opis}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="scene scene--text kvaliteta">
        <h2 class="huge reveal">{s.kvaliteta.naslov}</h2>
        <p class="lead reveal">{s.kvaliteta.tekst}</p>
      </section>

      <section class="scene radovi" id="radovi" aria-labelledby="radovi-h">
        <div class="radovi__head">
          <p class="slate reveal">{two(galerija.prije_poslije.length + 3)} — Kadrovi</p>
          <h2 id="radovi-h" class="big reveal">{s.projekti_naslov}</h2>
        </div>
        <ul class="reel" role="list" data-group>
          {galerija.slike.map((g, i) => (
            <li>
              <Pic src={g.slika} alt={g.opis} sizes="(min-width: 56rem) 34vh, 70vw" />
              <p class="reel__no">{two(i + 1)}</p>
            </li>
          ))}
        </ul>
      </section>

      <section class="scene credits" id="cjenik" aria-labelledby="cjenik-h">
        <p class="slate">Odjavna špica</p>
        <h2 id="cjenik-h" class="big">Cjenik*</h2>
        <table>
          <caption class="sr">Cjenik keramičarskih usluga</caption>
          <thead>
            <tr><th scope="col">Usluga</th><th scope="col">Jedinica</th><th scope="col">{cjenik.naslov_cijena}</th>{druga && <th scope="col">{druga}</th>}</tr>
          </thead>
          <tbody>
            {cjenik.stavke.map((r) => (
              <tr>
                <th scope="row">{nb(r.usluga)}</th>
                <td class="unit">{r.jedinica}</td>
                <td class="price" data-label={cjenik.naslov_cijena}>{nb(r.cijena)}</td>
                {druga && <td class="price" data-label={druga}>{nb(r.druga_cijena ?? '–')}</td>}
              </tr>
            ))}
          </tbody>
        </table>
        <p class="note">*{cjenik.napomena}</p>
        <a class="btn" href={url('cjenik.csv')} download="cjenik-m2-keramika.csv"><Icon name="download" /><span>Preuzmite cjenik (CSV)</span></a>
      </section>
    </main>

    <footer class="scene end" id="kontakt">
      <p class="slate">Kontakt</p>
      <a class="end__tel" href={tel}>{s.telefon}</a>
      <p class="end__text">{s.kontakt_tekst.trim()}</p>
      <div class="end__actions">
        <a class="btn btn--amber" href={tel}><Icon name="phone" /><span>Nazovite</span></a>
        <a class="btn" href={`mailto:${s.email}`}><Icon name="mail" /><span>{s.email}</span></a>
      </div>
      <address>
        {s.naziv}, vl. {s.vlasnik}<br />
        <a href={maps} target="_blank" rel="noopener">{s.adresa}</a>
      </address>
      <p class="copy">© {new Date().getFullYear()} {s.naziv}</p>
    </footer>
    <Lightbox />
  </div>
</Base>
