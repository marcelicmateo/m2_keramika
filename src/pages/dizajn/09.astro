---
// 09 · Editorial magazin: an interiors magazine issue — masthead, cover, editorial, features, photo spreads, price index, colophon.
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Foto from '../../designs/09/Foto.astro';
import Lightbox from '../../designs/09/Lightbox.astro';
import '../../designs/09/style.css';
import hero from '../../assets/bazen.jpg';
import { url } from '../../url';

const s = (await getEntry('stranica', 'stranica'))!.data;
const { usluge } = (await getEntry('usluge', 'usluge'))!.data;
const { slike, prije_poslije } = (await getEntry('galerija', 'galerija'))!.data;
const cjenik = (await getEntry('cjenik', 'cjenik'))!.data;

const tel = `tel:${s.telefon.replace(/\s/g, '')}`;
const maps = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(s.adresa);
const grad = s.adresa.split(',').at(-1)!.trim();
const godina = new Date().getFullYear();
const nb = (t: string) => t.replace(/ (?=(m[²¹]|cm|€)(?!\p{L}))/gu, ' ');
const dva = (n: number) => String(n).padStart(2, '0');
const [prva, ...ostale] = slike;
const sadrzaj = [
  ['uvodnik', 'Uvodnik'],
  ['usluge', 'Usluge'],
  ['reportaza', 'Reportaža'],
  ['cjenik', 'Cjenik'],
  ['kontakt', 'Kontakt'],
];
---
<Base>
  <div class="mag">
    <header class="mast wrap">
      <div class="mast__top">
        <span>Broj {dva(1)} · {grad}, {godina}.</span>
        <a href={tel} class="mast__tel">Nazovite <b>{s.telefon}</b></a>
      </div>
      <h1 class="mast__title">{s.naziv}</h1>
      <nav class="mast__nav" aria-label="Sadržaj">
        <ol role="list">
          {sadrzaj.map(([id, naziv], n) => <li><a href={`#${id}`}><span>{dva(n + 2)}</span> {naziv}</a></li>)}
        </ol>
      </nav>
    </header>

    <main>
      <section class="cover wrap" aria-label="Naslovnica">
        <figure class="cover__fig">
          <Image src={hero} alt="" widths={[800, 1200, 1600]} sizes="(min-width: 64rem) 58vw, 100vw" quality={72} loading="eager" fetchpriority="high" />
        </figure>
        <div class="cover__lines">
          <p class="kicker">Tema broja</p>
          <p class="cover__head">{s.slogan}</p>
          <ul class="cover__list" role="list">
            {usluge.map((u, n) => <li><span class="num">{dva(n + 1)}</span><span><b>{u.naslov}</b> {u.istaknuto}</span></li>)}
          </ul>
          <a href={tel} class="cover__cta"><span>Za procjenu radova nazovite</span> <b>{s.telefon}</b></a>
        </div>
      </section>

      <section id="uvodnik" class="sec wrap" aria-labelledby="uvod-h">
        <p class="folio"><span>Uvodnik</span><span>str. 02</span></p>
        <div class="uvod">
          <h2 id="uvod-h" class="display">{s.uvod.naslov}</h2>
          <div class="uvod__body">
            <p class="drop">{s.uvod.tekst}</p>
            <p class="sig">— {s.vlasnik}, vlasnik</p>
          </div>
        </div>
      </section>

      <section id="usluge" class="sec wrap" aria-labelledby="usluge-h">
        <p class="folio"><span>Usluge</span><span>str. 03</span></p>
        <h2 id="usluge-h" class="sec__h">Usluge</h2>
        <div class="arts">
          {usluge.map((u, n) => (
            <article class="art">
              <p class="art__no">{dva(n + 1)}</p>
              <h3>{u.naslov}</h3>
              <p class="art__dek">{u.istaknuto}</p>
              <p class="art__body">{u.opis}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="pull wrap" aria-labelledby="kval-h">
        <h2 id="kval-h" class="kicker">{s.kvaliteta.naslov}</h2>
        <p class="pull__q">{s.kvaliteta.tekst}</p>
      </section>

      <section id="reportaza" class="sec wrap" aria-labelledby="rep-h">
        <p class="folio"><span>Reportaža</span><span>str. 04</span></p>
        <div class="spread gallery" data-group>
          <figure class="spread__lead">
            <Foto src={prva.slika} alt={prva.opis} sizes="(min-width: 64rem) 52vw, 100vw" />
            <figcaption><b>Sl. 1</b> {prva.opis}</figcaption>
          </figure>
          <div class="spread__text">
            <p class="kicker">Reportaža</p>
            <h2 id="rep-h" class="display">{s.projekti_naslov}</h2>
            <ol class="index" role="list">
              {slike.map((f, n) => <li><b>{n + 1}</b> {f.opis}</li>)}
            </ol>
          </div>
          <ul class="spread__rest" role="list">
            {ostale.map((f, n) => (
              <li>
                <figure>
                  <Foto src={f.slika} alt={f.opis} sizes="(min-width: 64rem) 30vw, (min-width: 40rem) 45vw, 100vw" />
                  <figcaption><b>Sl. {n + 2}</b> {f.opis}</figcaption>
                </figure>
              </li>
            ))}
          </ul>
        </div>

        {prije_poslije.map((set) => {
          const koraci = [
            { label: 'Prije', src: set.prije },
            ...(set.tijekom ? [{ label: 'Tijekom', src: set.tijekom }] : []),
            { label: 'Poslije', src: set.poslije },
          ];
          return (
            <article class="set">
              <header class="set__head">
                <p class="kicker">Prije i poslije</p>
                <h3 class="display">{set.naslov}</h3>
                <p class="set__dek">{set.opis}</p>
              </header>
              <ol class="set__row" role="list" data-group>
                {koraci.map((k, n) => (
                  <li>
                    <figure>
                      <p class="set__label"><span>{dva(n + 1)}</span> {k.label}</p>
                      <Foto src={k.src} alt={`${k.label} – ${set.opis}`} sizes="(min-width: 48rem) 30vw, 75vw" />
                    </figure>
                  </li>
                ))}
              </ol>
            </article>
          );
        })}
      </section>

      <section id="cjenik" class="sec wrap" aria-labelledby="cjenik-h">
        <p class="folio"><span>Cjenik</span><span>str. 05</span></p>
        <div class="cjenik">
          <header>
            <h2 id="cjenik-h" class="display">Cjenik<span aria-hidden="true">*</span></h2>
            <p class="cjenik__note">*{cjenik.napomena}</p>
            <a class="more" href={url('cjenik.csv')} download="cjenik-m2-keramika.csv">Preuzmite cjenik (CSV) <span aria-hidden="true">→</span></a>
          </header>
          <table>
            <caption class="sr">Cjenik keramičarskih usluga</caption>
            <thead>
              <tr>
                <th scope="col">Usluga</th>
                <th scope="col">Jed.</th>
                <th scope="col" class="price">{cjenik.naslov_cijena}</th>
                {cjenik.naslov_druga_cijena && <th scope="col" class="price">{cjenik.naslov_druga_cijena}</th>}
              </tr>
            </thead>
            <tbody>
              {cjenik.stavke.map((r) => (
                <tr>
                  <th scope="row">{nb(r.usluga)}</th>
                  <td class="unit">{r.jedinica}</td>
                  <td class="price" data-label={cjenik.naslov_cijena}>{nb(r.cijena)}</td>
                  {cjenik.naslov_druga_cijena && <td class="price" data-label={cjenik.naslov_druga_cijena}>{nb(r.druga_cijena ?? '–')}</td>}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    </main>

    <footer id="kontakt" class="colophon">
      <div class="wrap">
        <p class="folio"><span>Kontakt</span><span>str. 06</span></p>
        <div class="colophon__grid">
          <div>
            <h2 class="display">Nazovite</h2>
            <a href={tel} class="colophon__tel">{s.telefon}</a>
            <a href={`mailto:${s.email}`} class="colophon__mail">{s.email}</a>
            <p class="colophon__text">{s.kontakt_tekst.trim()}</p>
          </div>
          <dl class="impressum">
            <div><dt>Izdavač</dt><dd>{s.naziv}</dd></div>
            <div><dt>Vlasnik</dt><dd>{s.vlasnik}</dd></div>
            <div><dt>Adresa</dt><dd><a href={maps} target="_blank" rel="noopener">{s.adresa}</a></dd></div>
            <div><dt>Telefon</dt><dd><a href={tel}>{s.telefon}</a></dd></div>
            <div><dt>E-pošta</dt><dd><a href={`mailto:${s.email}`}>{s.email}</a></dd></div>
          </dl>
        </div>
        <p class="colophon__end">© {godina} {s.naziv} <span aria-hidden="true">■</span></p>
      </div>
    </footer>
    <Lightbox />
  </div>
</Base>
