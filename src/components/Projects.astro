---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import pozadina from '../assets/pozadina-projekti.jpg';
import Ornament from './Ornament.astro';
import Photo from './Photo.astro';
import Lightbox from './Lightbox.astro';

interface Props {
  kvaliteta: { naslov: string; tekst: string };
  projektiNaslov: string;
  slike: { slika: ImageMetadata; opis: string }[];
  prijePoslije: {
    naslov: string;
    prije: ImageMetadata;
    tijekom?: ImageMetadata;
    poslije: ImageMetadata;
    opis: string;
  }[];
}
const { kvaliteta, projektiNaslov, slike, prijePoslije } = Astro.props;
const gridSizes = '(min-width: 60rem) 280px, (min-width: 22rem) 45vw, 90vw';
const trioSizes = '(min-width: 60rem) 280px, (min-width: 40rem) 42vw, 80vw';
---
<section class="projects bg section">
  <Image class="bg-img" src={pozadina} alt="" widths={[640, 1280, 1920]} sizes="100vw" quality={60} />
  <div class="wrap">
    <div class="center">
      <Ornament />
      <h2>{kvaliteta.naslov}</h2>
      <p class="measure lead">{kvaliteta.tekst}</p>
    </div>

    <h3 class="projects__title">{projektiNaslov}</h3>
    <ul class="gallery" role="list">
      {slike.map((s) => (
        <li><Photo src={s.slika} alt={s.opis} sizes={gridSizes} /></li>
      ))}
    </ul>

    {prijePoslije.map((set) => {
      const koraci = [
        { label: 'Prije', src: set.prije },
        ...(set.tijekom ? [{ label: 'U procesu', src: set.tijekom }] : []),
        { label: 'Poslije', src: set.poslije },
      ];
      return (
        <figure class="set">
          {set.naslov && <figcaption class="set__title">{set.naslov}</figcaption>}
          <ol class="set__row" role="list">
            {koraci.map((k) => (
              <li>
                <p class="set__label">{k.label}</p>
                <Photo src={k.src} alt={`${k.label} – ${set.opis}`} sizes={trioSizes} />
              </li>
            ))}
          </ol>
          <p class="set__hint" aria-hidden="true">← povucite →</p>
        </figure>
      );
    })}
  </div>
  <Lightbox />
</section>

<style>
  .projects { color: var(--c-on-dark); }
  .projects::before { background: var(--overlay-strong); }
  .projects .ornament { color: var(--c-stone); }
  .lead { margin-top: var(--space-5); font-size: var(--fs-lead); }
  h2, .lead, .projects__title, .set__title, .set__label { text-shadow: 0 1px 10px rgb(0 0 0 / 0.5); }

  .projects__title { margin: var(--space-8) 0 var(--space-5); }

  /* Gallery: flex so an orphan last tile is centred. */
  .gallery {
    --cols: 1;
    --gap: var(--space-4);
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--gap);
  }
  .gallery > li { flex: 0 0 calc((100% - (var(--cols) - 1) * var(--gap)) / var(--cols)); }
  @media (min-width: 22rem) { .gallery { --cols: 2; } }
  @media (min-width: 60rem) { .gallery { --cols: 4; --gap: var(--space-5); } }

  .set { margin-top: var(--space-8); }
  .set__title { font-size: var(--fs-h3); font-weight: 600; margin-bottom: var(--space-4); }
  .set__row {
    list-style: none;
    padding: 0 0 var(--space-3);
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 80%;
    gap: var(--space-4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
  }
  .set__row > li { scroll-snap-align: start; }
  .set__label { font-weight: 600; margin-bottom: var(--space-2); }
  .set__hint { font-size: var(--fs-small); text-align: center; margin-top: var(--space-2); opacity: 0.85; }
  @media (min-width: 40rem) { .set__row { grid-auto-columns: 42%; } }

  @media (min-width: 60rem) {
    .set__row { grid-auto-flow: row; grid-template-columns: repeat(3, 1fr); grid-auto-columns: auto; gap: var(--space-6); overflow: visible; }
    .set__hint { display: none; }
  }
</style>
