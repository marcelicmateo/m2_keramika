---
// One framed 3:4 photo that opens in the lightbox (or the large image without JS).
import type { ImageMetadata } from 'astro';
import { Picture, getImage } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
}
const { src, alt, sizes } = Astro.props;
const large = await getImage({ src, width: Math.min(1600, src.width), format: 'webp' });
---
<a class="photo" href={large.src} data-lightbox>
  <Picture src={src} alt={alt} formats={['avif', 'webp']} widths={[400, 800, 1200]} sizes={sizes} loading="lazy" decoding="async" />
</a>

<style>
  .photo {
    display: block;
    padding: 4px;
    background: #fff;
    border-radius: var(--radius);
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.35);
    transition: transform 0.2s;
  }
  .photo:hover { transform: translateY(-2px); }
  .photo :global(img) {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: calc(var(--radius) - 3px);
  }
</style>
