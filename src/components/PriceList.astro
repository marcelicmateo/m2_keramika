---
import Button from './Button.astro';
import Icon from './Icon.astro';
import { url } from '../url';

interface Props {
  napomena: string;
  naslov_cijena: string;
  naslov_druga_cijena?: string;
  stavke: { usluga: string; jedinica: string; cijena: string; druga_cijena?: string }[];
}
const { napomena, naslov_cijena, naslov_druga_cijena, stavke } = Astro.props;
// Keep numbers with their units on one line: "0,4 m²", "80 cm", "30 €".
const nb = (t: string) => t.replace(/ (?=(m[²¹]|cm|€)(?!\p{L}))/gu, '\u00A0');
---
<section class="section wrap" aria-labelledby="cjenik">
  <h2 id="cjenik">Cjenik*</h2>
  <div class="panel">
    <table>
      <caption class="visually-hidden">Cjenik keramičarskih usluga</caption>
      <thead>
        <tr><th scope="col">Usluga</th><th scope="col">Jedinica</th><th scope="col" class="price">{naslov_cijena}</th>{naslov_druga_cijena && <th scope="col" class="price">{naslov_druga_cijena}</th>}</tr>
      </thead>
      <tbody>
        {stavke.map((s) => (
          <tr>
            <th scope="row">{nb(s.usluga)}</th>
            <td class="unit">{s.jedinica}</td>
            <td class="price" data-label={naslov_cijena}>{nb(s.cijena)}</td>
            {naslov_druga_cijena && <td class="price" data-label={naslov_druga_cijena}>{nb(s.druga_cijena ?? '–')}</td>}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="note">*{napomena}</p>
  <Button href={url('cjenik.csv')} download="cjenik-m2-keramika.csv"><Icon slot="icon" name="download" />Preuzmite cjenik (CSV)</Button>
</section>

<style>
  h2 { margin-bottom: var(--space-5); }
  .panel {
    background: var(--c-ink);
    color: var(--c-on-dark);
    border-radius: var(--radius);
    padding: var(--space-2) var(--space-5);
  }
  table { width: 100%; font-variant-numeric: tabular-nums; }
  th, td { text-align: left; font-weight: 400; padding: var(--space-3) var(--space-2); vertical-align: baseline; }
  thead th { font-weight: 600; color: var(--c-stone); font-size: var(--fs-small); text-transform: uppercase; letter-spacing: 0.06em; }
  tbody tr { border-top: 1px solid rgb(164 164 164 / 0.45); }
  tbody tr:hover { background: #1d1d1d; }
  .unit { white-space: nowrap; }
  .price { text-align: right; white-space: nowrap; }
  .note { margin: var(--space-4) 0 var(--space-5); font-size: var(--fs-small); color: var(--c-ink-soft); max-width: var(--measure); }

  /* Phone: same table, stacked rows. Name + unit on the left, the price(s) on the right, each labelled. */
  @media (max-width: 39.99rem) {
    .panel { padding: var(--space-1) var(--space-4); }
    thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    tbody tr {
      display: grid;
      grid-template-columns: 1fr auto;
      column-gap: var(--space-4);
      padding-block: var(--space-3);
    }
    tbody tr:first-child { border-top: 0; }
    th, td { padding: 0; }
    tbody th { grid-column: 1; grid-row: 1; }
    .unit { grid-column: 1; grid-row: 2; font-size: var(--fs-small); color: var(--c-line); }
    .price { grid-column: 2; white-space: normal; max-width: 9rem; font-weight: 600; }
    .price::before { content: attr(data-label); display: block; font-size: 0.75rem; font-weight: 400; color: var(--c-line); }
    .price + .price { margin-top: var(--space-2); }
    tbody tr { grid-auto-rows: auto; }
    tbody th, .unit { align-self: start; }
    .price:first-of-type { grid-row: 1 / span 2; }
  }
</style>
