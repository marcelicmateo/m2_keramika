---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import nebo from '../assets/pozadina-projekti.jpg';
import Button from './Button.astro';
import Icon from './Icon.astro';
import { url } from '../url';

interface Props {
  telefon: string;
  email: string;
}
const { telefon, email } = Astro.props;
const tel = `tel:${telefon.replace(/\s/g, '')}`;
---
<header class="header bg">
  <Image class="bg-img" src={nebo} alt="" widths={[640, 1280, 1920]} sizes="100vw" quality={60} loading="eager" />
  <div class="wrap header__in">
    <a href={url()} class="header__logo">
      <Image src={logo} alt="M² Keramika" widths={[120, 160, 240, 320]} sizes="(min-width: 40rem) 160px, 120px" loading="eager" />
    </a>
    <nav class="header__actions" aria-label="Kontakt">
      <Button href={tel}><Icon slot="icon" name="phone" />{telefon}</Button>
      <Button href={`mailto:${email}`}><Icon slot="icon" name="mail" />{email}</Button>
    </nav>
  </div>
</header>

<style>
  .header::before { background: none; }
  .header .bg-img { object-position: 50% 0%; }
  .header__in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: 0.375rem;
  }
  .header__logo { flex: none; border-radius: var(--radius); }
  .header__logo img { width: clamp(80px, 26vw, 120px); }
  /* Phones: the two buttons stack on the right, slightly more compact. */
  .header__actions { display: flex; flex-direction: column; align-items: stretch; gap: var(--space-2); }
  .header__actions :global(.btn) { justify-content: flex-start; padding: 0.5rem 0.75rem; font-size: 0.875rem; }

  @media (min-width: 40rem) {
    .header__in { padding-block: var(--space-4); }
    .header__logo img { width: 160px; }
    .header__actions { flex-direction: row; }
    .header__actions :global(.btn) { padding: 0.75rem 1.25rem; font-size: 0.9375rem; }
  }
</style>
