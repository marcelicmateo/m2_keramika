---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import Button from './Button.astro';
import Icon from './Icon.astro';
import { url } from '../url';

interface Props {
  telefon: string;
  email: string;
}
const { telefon, email } = Astro.props;
const tel = `tel:${telefon.replace(/\s/g, '')}`;
---
<header class="header">
  <div class="wrap header__in">
    <a href={url()} class="header__logo">
      <Image src={logo} alt="M² Keramika" widths={[168, 200, 336, 400]} sizes="(min-width: 40rem) 200px, 168px" loading="eager" />
    </a>
    <nav class="header__actions" aria-label="Kontakt">
      <Button href={tel}><Icon slot="icon" name="phone" />{telefon}</Button>
      <Button href={`mailto:${email}`}><Icon slot="icon" name="mail" />{email}</Button>
    </nav>
  </div>
</header>

<style>
  /* Sits on top of the hero photo, so the page starts with one continuous image. */
  .header { position: absolute; inset: 0 0 auto; z-index: 10; }
  .header__in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap; /* very narrow phones: buttons drop under the logo */
    gap: var(--space-3);
    padding-block: var(--space-3);
  }
  .header__logo { flex: none; border-radius: var(--radius); }
  .header__logo img { width: clamp(96px, 100vw - 236px, 168px); } /* fills what the buttons leave */
  /* Phones: the two buttons stack on the right, slightly more compact. */
  .header__actions { display: flex; flex-direction: column; align-items: stretch; gap: var(--space-2); }
  .header__actions :global(.btn) { justify-content: flex-start; padding: 0.5rem 0.625rem; font-size: 0.8125rem; }

  @media (min-width: 40rem) {
    .header__in { padding-block: var(--space-4); }
    .header__logo img { width: 200px; }
    .header__actions { flex-direction: row; }
    .header__actions :global(.btn) { padding: 0.75rem 1.25rem; font-size: 0.9375rem; }
  }
</style>
