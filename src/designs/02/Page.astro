---
// 02 · Azulejo — Dalmatian majolica: hand-painted blue-and-white tiles (SVG), sections framed like tile panels.
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Shot from '../../designs/02/Shot.astro';
import Lightbox from '../../designs/02/Lightbox.astro';
import { tile, band, frame, night, data } from '../../designs/02/tiles';
import { url } from '../../url';
import '../../designs/02/style.css';

const s = (await getEntry('stranica', 'stranica'))!.data;
const { usluge } = (await getEntry('usluge', 'usluge'))!.data;
const galerija = (await getEntry('galerija', 'galerija'))!.data;
const cjenik = (await getEntry('cjenik', 'cjenik'))!.data;

const tel = `tel:${s.telefon.replace(/\s/g, '')}`;
const maps = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(s.adresa);
const nb = (t: string) => t.replace(/ (?=(m[²¹]|cm|€)(?!\p{L}))/gu, ' ');
const druga = cjenik.naslov_druga_cijena;
const grad = s.adresa.split(',').pop()?.trim();
const tiles = `--tile:${data(tile(8))};--band:${data(band)};--frame:${data(frame)};--night:${data(night)}`;
const emblems = [4, 6, 8, 12].map((n) => data(tile(n, { joints: false })));
---
<Base>
  <div class="az" style={tiles}>
    <header class="top">
      <a class="top__brand" href={url('dizajn/02/')}>M<sup>2</sup> Keramika</a>
      <nav class="top__nav" aria-label="Sadržaj">
        <a href="#usluge">Usluge</a>
        <a href="#radovi">Radovi</a>
        <a href="#cjenik">Cjenik</a>
      </nav>
      <a class="top__tel" href={tel}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z" /></svg>
        <span>{s.telefon}</span>
      </a>
    </header>

    <main>
      <section class="hero" aria-labelledby="naslov">
        <div class="hero__panel framed">
          <p class="kicker">Keramičarski obrt · {grad}</p>
          <h1 id="naslov">{s.slogan}</h1>
          <span class="orn" aria-hidden="true"><i></i><i></i><i></i></span>
          <div class="hero__cta">
            <a class="btn" href={tel}><small>Nazovite</small>{s.telefon}</a>
            <a class="link" href={`mailto:${s.email}`}>{s.email}</a>
          </div>
        </div>
      </section>

      <section class="intro wrap" aria-labelledby="uvod">
        <h2 id="uvod">{s.uvod.naslov}</h2>
        <p class="lead">{s.uvod.tekst}</p>
      </section>

      <section class="services wrap" id="usluge" aria-labelledby="usluge-h">
        <h2 id="usluge-h" class="center">Usluge</h2>
        <ul class="cards" role="list">
          {usluge.map((u, i) => (
            <li class="card">
              <span class="card__tile" style={`background-image:${emblems[i % emblems.length]}`}></span>
              <h3>{u.naslov}</h3>
              <p class="card__k">{u.istaknuto}</p>
              <p>{u.opis}</p>
            </li>
          ))}
        </ul>
      </section>

      <section class="quality" aria-labelledby="kvaliteta">
        <div class="quality__in">
          <h2 id="kvaliteta">{s.kvaliteta.naslov}</h2>
          <p class="lead">{s.kvaliteta.tekst}</p>
        </div>
      </section>

      <section class="works wrap" id="radovi" aria-labelledby="radovi-h">
        <h2 id="radovi-h" class="center">{s.projekti_naslov}</h2>
        <ul class="gallery" role="list" data-group>
          {galerija.slike.map((g) => (
            <li>
              <figure>
                <Shot src={g.slika} alt={g.opis} sizes="(min-width: 64rem) 300px, (min-width: 40rem) 45vw, 90vw" />
                <figcaption>{g.opis}</figcaption>
              </figure>
            </li>
          ))}
        </ul>

        {galerija.prije_poslije.map((set) => {
          const koraci = [
            { label: 'Prije', src: set.prije },
            ...(set.tijekom ? [{ label: 'U procesu', src: set.tijekom }] : []),
            { label: 'Poslije', src: set.poslije },
          ];
          return (
            <figure class="set framed" data-group>
              <figcaption>
                <h3>{set.naslov}</h3>
                <p>{set.opis}</p>
              </figcaption>
              <ol class="set__steps" role="list">
                {koraci.map((k) => (
                  <li>
                    <p class="set__l">{k.label}</p>
                    <Shot src={k.src} alt={`${k.label} – ${set.opis}`} sizes="(min-width: 64rem) 300px, 70vw" />
                  </li>
                ))}
              </ol>
            </figure>
          );
        })}
      </section>

      <section class="prices wrap" id="cjenik" aria-labelledby="cjenik-h">
        <div class="framed prices__panel">
          <h2 id="cjenik-h" class="center">Cjenik*</h2>
          <table>
            <caption class="visually-hidden">Cjenik keramičarskih usluga</caption>
            <thead>
              <tr>
                <th scope="col">Usluga</th>
                <th scope="col" class="u">Jed.</th>
                <th scope="col" class="c">{cjenik.naslov_cijena}</th>
                {druga && <th scope="col" class="c">{druga}</th>}
              </tr>
            </thead>
            <tbody>
              {cjenik.stavke.map((r) => (
                <tr>
                  <th scope="row"><span>{nb(r.usluga)}</span></th>
                  <td class="u">{r.jedinica}</td>
                  <td class="c" data-label={cjenik.naslov_cijena} data-u={r.jedinica}>{nb(r.cijena)}</td>
                  {druga && <td class="c" data-label={druga} data-u={r.jedinica}>{nb(r.druga_cijena ?? '–')}</td>}
                </tr>
              ))}
            </tbody>
          </table>
          <p class="note">*{cjenik.napomena}</p>
          <p class="center"><a class="btn btn--ghost" href={url('cjenik.csv')} download="cjenik-m2-keramika.csv">Preuzmite cjenik (CSV)</a></p>
        </div>
      </section>
    </main>

    <footer class="foot" aria-labelledby="kontakt">
      <div class="foot__in">
        <h2 id="kontakt">Kontakt</h2>
        <p class="foot__text">{s.kontakt_tekst.trim()}</p>
        <a class="foot__tel" href={tel}>{s.telefon}</a>
        <p><a class="link" href={`mailto:${s.email}`}>{s.email}</a></p>
        <address>
          {s.naziv}, vl. {s.vlasnik}<br />
          <a class="link" href={maps} target="_blank" rel="noopener">{s.adresa}</a>
        </address>
        <p class="copy">© {new Date().getFullYear()} {s.naziv}</p>
      </div>
    </footer>
    <Lightbox />
  </div>
</Base>
