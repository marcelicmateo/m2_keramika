---
// A photo that opens in the lightbox (or the large image without JS).
import type { ImageMetadata } from 'astro';
import { Picture, getImage } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  eager?: boolean;
}
const { src, alt, sizes, eager } = Astro.props;
const large = await getImage({ src, width: src.width >= 1600 ? 1600 : 1200, format: 'webp' });
---
<a class="foto" href={large.src} data-lightbox>
  <Picture src={src} alt={alt} formats={['avif', 'webp']} widths={[400, 800, 1200]} sizes={sizes} loading={eager ? 'eager' : 'lazy'} decoding="async" />
</a>
