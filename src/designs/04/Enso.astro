---
// A brush-drawn ensō: an open circle with a rough, dry edge.
interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
const id = 'enso-' + Math.random().toString(36).slice(2, 8);
---
<svg class:list={['enso', cls]} viewBox="0 0 200 200" aria-hidden="true" focusable="false">
  <filter id={id} x="-10%" y="-10%" width="120%" height="120%">
    <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="4" result="n" />
    <feDisplacementMap in="SourceGraphic" in2="n" scale="5" />
  </filter>
  <g filter={`url(#${id})`} fill="none" stroke="currentColor" stroke-linecap="round">
    <path d="M128 22C78 6 24 40 24 100s46 82 86 78c44-4 70-40 66-82-3-30-20-50-40-60" stroke-width="13" pathLength="100" stroke-dasharray="94 100" />
    <path d="M124 26C80 14 32 46 32 100s44 74 80 70" stroke-width="4" opacity="0.5" />
  </g>
</svg>

<style>
  .enso { display: block; width: 100%; height: auto; color: var(--clay-soft); }
</style>
