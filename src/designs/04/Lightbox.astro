<dialog id="lightbox" class="lb" aria-label="Uvećana fotografija">
  <img alt="" />
  <p class="lb__cap"><span class="lb__n"></span> <span class="lb__t"></span></p>
  <form method="dialog"><button class="lb__close" aria-label="Zatvori">zatvori</button></form>
  <button class="lb__nav lb__nav--prev" type="button" aria-label="Prethodna fotografija">←</button>
  <button class="lb__nav lb__nav--next" type="button" aria-label="Sljedeća fotografija">→</button>
</dialog>

<script>
  const dlg = document.getElementById('lightbox') as HTMLDialogElement;
  const img = dlg.querySelector('img')!;
  const n = dlg.querySelector('.lb__n')!;
  const t = dlg.querySelector('.lb__t')!;
  let group: HTMLAnchorElement[] = [];
  let i = 0;

  // Show photo k of the current group (the set the clicked photo belongs to), wrapping around.
  const show = (k: number) => {
    i = (k + group.length) % group.length;
    img.src = group[i].href;
    img.alt = t.textContent = group[i].querySelector('img')?.alt ?? '';
    n.textContent = `${String(i + 1).padStart(2, '0')}/${String(group.length).padStart(2, '0')}`;
    dlg.classList.toggle('is-single', group.length < 2);
  };

  document.addEventListener('click', (e) => {
    const a = (e.target as Element).closest<HTMLAnchorElement>('a[data-lightbox]');
    if (!a) return;
    e.preventDefault();
    group = [...(a.closest('[data-group]') ?? document).querySelectorAll<HTMLAnchorElement>('a[data-lightbox]')];
    show(group.indexOf(a));
    dlg.showModal();
  });

  dlg.querySelector('.lb__nav--prev')!.addEventListener('click', () => show(i - 1));
  dlg.querySelector('.lb__nav--next')!.addEventListener('click', () => show(i + 1));
  dlg.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(i - 1);
    if (e.key === 'ArrowRight') show(i + 1);
  });
  let x0 = 0;
  dlg.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
  dlg.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - x0;
    if (Math.abs(dx) > 50) show(dx < 0 ? i + 1 : i - 1);
  });
  dlg.addEventListener('click', (e) => {
    if (e.target === dlg) dlg.close();
  });
</script>

<style>
  .lb {
    max-width: none;
    max-height: none;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 64px 16px 20px;
    border: 0;
    background: var(--washi);
    color: var(--ink);
  }
  .lb[open] { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16px; }
  .lb::backdrop { background: rgb(43 38 32 / 0.5); }
  .lb img { max-width: 100%; max-height: calc(100svh - 170px); width: auto; object-fit: contain; border-radius: 4px 16px 6px 20px / 18px 5px 14px 6px; }
  .lb__cap { font: italic 500 1.25rem/1.4 var(--serif); text-align: center; max-width: 36rem; }
  .lb__n { font-style: normal; font-size: 0.875rem; letter-spacing: 0.14em; color: var(--clay); margin-right: 10px; font-variant-numeric: lining-nums; }
  .lb__nav, .lb__close {
    position: absolute;
    min-width: 48px;
    height: 48px;
    border: 0;
    background: none;
    color: var(--ink);
    font: 500 1.5rem/1 var(--serif);
    cursor: pointer;
  }
  .lb__nav { top: 50%; translate: 0 -50%; }
  .lb__nav--prev { left: 8px; }
  .lb__nav--next { right: 8px; }
  .lb.is-single .lb__nav { display: none; }
  .lb__close { top: 8px; right: 12px; padding: 0 12px; font-size: 1.125rem; font-style: italic; text-decoration: underline; text-underline-offset: 6px; }
  .lb__nav:hover, .lb__close:hover { color: var(--clay); }
  .lb :focus-visible { outline: 2px solid var(--clay); outline-offset: 2px; }
  @media (max-width: 40rem) { .lb__nav { top: auto; bottom: 12px; translate: none; } .lb { padding-bottom: 72px; } }
</style>
