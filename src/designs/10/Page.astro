---
// 10 · Neo-brutal veselo: flat bright colours, chunky outlines, hard shadows, stickers, slightly tilted cards.
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Foto from '../../designs/10/Foto.astro';
import Lightbox from '../../designs/10/Lightbox.astro';
import '../../designs/10/style.css';
import hero from '../../assets/bazen.jpg';
import { url } from '../../url';

const s = (await getEntry('stranica', 'stranica'))!.data;
const { usluge } = (await getEntry('usluge', 'usluge'))!.data;
const { slike, prije_poslije } = (await getEntry('galerija', 'galerija'))!.data;
const cjenik = (await getEntry('cjenik', 'cjenik'))!.data;

const tel = `tel:${s.telefon.replace(/\s/g, '')}`;
const maps = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(s.adresa);
const grad = s.adresa.split(',').at(-1)!.trim();
const nb = (t: string) => t.replace(/ (?=(m[²¹]|cm|€)(?!\p{L}))/gu, ' ');
const nav = [['usluge', 'Usluge'], ['radovi', 'Radovi'], ['cjenik', 'Cjenik'], ['kontakt', 'Kontakt']];
const phoneIcon = 'M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z';
---
<Base>
  <header class="top">
    <div class="wrap top__in">
      <a href={url("dizajn/10/")} class="logo" aria-label={s.naziv}><span class="logo__m">M²</span><span class="logo__k">Keramika</span></a>
      <nav aria-label="Odjeljci" class="top__nav">
        {nav.map(([id, n]) => <a href={`#${id}`}>{n}</a>)}
      </nav>
      <a href={tel} class="btn btn--yellow btn--sm">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={phoneIcon} /></svg>
        <span>Nazovite</span>
      </a>
    </div>
  </header>

  <main>
    <section class="hero wrap">
      <div class="hero__text">
        <p class="sticker sticker--pink">Keramičar · {grad}</p>
        <h1>{s.naziv}</h1>
        <p class="hero__lead">{s.slogan}</p>
        <div class="hero__cta">
          <a href={tel} class="btn btn--yellow btn--lg">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={phoneIcon} /></svg>
            <span>{s.telefon}</span>
          </a>
          <a href={`mailto:${s.email}`} class="btn btn--white">{s.email}</a>
        </div>
      </div>
      <div class="hero__pic">
        <div class="frame">
          <Image src={hero} alt="" widths={[400, 800, 1200]} sizes="(min-width: 60rem) 45vw, 92vw" quality={72} loading="eager" fetchpriority="high" />
        </div>
        <svg class="burst" viewBox="0 0 100 100" aria-hidden="true">
          <path d="M50 2l7 14 15-7 1 16 16 0-6 15 14 8-12 11 9 13-16 3 1 16-15-5-7 14-7-14-15 5 1-16-16-3 9-13-12-11 14-8-6-15 16 0 1-16 15 7z" />
          <text x="50" y="47" text-anchor="middle">m²</text>
          <text x="50" y="64" text-anchor="middle" class="burst__small">po mjeri</text>
        </svg>
      </div>
    </section>

    <div class="marquee" aria-hidden="true">
      <div class="marquee__band"><div class="marquee__track">
        {[0, 1, 2, 3].map(() => (
          <ul role="list">{usluge.map((u) => <li>{u.naslov}</li>)}</ul>
        ))}
      </div></div>
    </div>

    <section class="intro wrap" aria-labelledby="uvod-h">
      <h2 id="uvod-h">{s.uvod.naslov}</h2>
      <p class="card card--white intro__text">{s.uvod.tekst}</p>
    </section>

    <section id="usluge" class="wrap sec" aria-labelledby="usluge-h">
      <h2 id="usluge-h" class="sec__h"><span class="hl">Usluge</span></h2>
      <ul class="services" role="list">
        {usluge.map((u, i) => (
          <li class="card service">
            <span class="badge" aria-hidden="true">{i + 1}</span>
            <h3>{u.naslov}</h3>
            <p class="service__lead">{u.istaknuto}</p>
            <p>{u.opis}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="quality" aria-labelledby="kval-h">
      <div class="wrap quality__in">
        <svg class="quality__star" viewBox="0 0 100 100" aria-hidden="true">
          <path d="M50 4l12 30 32 2-25 20 9 31-28-18-28 18 9-31-25-20 32-2z" />
        </svg>
        <div>
          <h2 id="kval-h">{s.kvaliteta.naslov}</h2>
          <p>{s.kvaliteta.tekst}</p>
        </div>
      </div>
    </section>

    <section id="radovi" class="wrap sec" aria-labelledby="radovi-h">
      <h2 id="radovi-h" class="sec__h"><span class="hl hl--blue">{s.projekti_naslov}</span></h2>
      <ul class="row gallery" role="list" data-group>
        {slike.map((f) => (
          <li class="polaroid">
            <Foto src={f.slika} alt={f.opis} sizes="(min-width: 60rem) 280px, (min-width: 40rem) 45vw, 78vw" />
            <p>{f.opis}</p>
          </li>
        ))}
      </ul>

      {prije_poslije.map((set) => {
        const koraci = [
          { label: 'Prije', src: set.prije },
          ...(set.tijekom ? [{ label: 'Tijekom', src: set.tijekom }] : []),
          { label: 'Poslije', src: set.poslije },
        ];
        return (
          <article class="set card card--green">
            <h3>{set.naslov}</h3>
            <p class="set__opis">{set.opis}</p>
            <ol class="row set__row" role="list" data-group>
              {koraci.map((k) => (
                <li class="set__step">
                  <span class="sticker set__label">{k.label}</span>
                  <Foto src={k.src} alt={`${k.label} – ${set.opis}`} sizes="(min-width: 60rem) 300px, (min-width: 40rem) 30vw, 72vw" />
                </li>
              ))}
            </ol>
          </article>
        );
      })}
    </section>

    <section id="cjenik" class="wrap sec" aria-labelledby="cjenik-h">
      <h2 id="cjenik-h" class="sec__h"><span class="hl hl--pink">Cjenik</span><span class="star" aria-hidden="true">*</span></h2>
      <div class="card card--white prices">
        <table>
          <caption class="sr">Cjenik keramičarskih usluga</caption>
          <thead>
            <tr>
              <th scope="col">Usluga</th>
              <th scope="col">Jed.</th>
              <th scope="col" class="price">{cjenik.naslov_cijena}</th>
              {cjenik.naslov_druga_cijena && <th scope="col" class="price">{cjenik.naslov_druga_cijena}</th>}
            </tr>
          </thead>
          <tbody>
            {cjenik.stavke.map((r) => (
              <tr>
                <th scope="row">{nb(r.usluga)}</th>
                <td class="unit"><span>{r.jedinica}</span></td>
                <td class="price" data-label={cjenik.naslov_cijena}><span>{nb(r.cijena)}</span></td>
                {cjenik.naslov_druga_cijena && <td class="price price--2" data-label={cjenik.naslov_druga_cijena}><span>{nb(r.druga_cijena ?? '–')}</span></td>}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="prices__foot">
        <p>*{cjenik.napomena}</p>
        <a href={url('cjenik.csv')} download="cjenik-m2-keramika.csv" class="btn btn--white">
          <svg viewBox="0 0 24 24" aria-hidden="true" class="stroke"><path d="M12 3v12M7 10l5 5 5-5M4 20h16" /></svg>
          <span>Preuzmite cjenik (CSV)</span>
        </a>
      </div>
    </section>
  </main>

  <footer id="kontakt" class="foot">
    <div class="wrap foot__in">
      <div>
        <h2>Javite se!</h2>
        <p class="foot__text">{s.kontakt_tekst.trim()}</p>
      </div>
      <div class="foot__actions">
        <a href={tel} class="btn btn--yellow btn--lg">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={phoneIcon} /></svg>
          <span>{s.telefon}</span>
        </a>
        <a href={`mailto:${s.email}`} class="btn btn--white">{s.email}</a>
        <address class="card card--white">
          <b>{s.naziv}</b>, vl. {s.vlasnik}<br />
          <a href={maps} target="_blank" rel="noopener">{s.adresa}</a>
        </address>
      </div>
    </div>
    <p class="wrap foot__copy">© {new Date().getFullYear()} {s.naziv}</p>
  </footer>
  <Lightbox />
</Base>
