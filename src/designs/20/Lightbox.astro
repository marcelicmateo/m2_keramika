<dialog class="lb" aria-label="Uvećana fotografija">
  <img alt="" />
  <p class="lb__cap"></p>
  <form method="dialog"><button class="lb__btn lb__close" aria-label="Zatvori">✕</button></form>
  <button class="lb__btn lb__prev" type="button" aria-label="Prethodna fotografija">‹</button>
  <button class="lb__btn lb__next" type="button" aria-label="Sljedeća fotografija">›</button>
</dialog>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('dialog.lb')!;
  const img = dlg.querySelector('img')!;
  const cap = dlg.querySelector('p')!;
  let group: HTMLAnchorElement[] = [];
  let i = 0;

  // Photos are grouped by the nearest [data-group]; prev/next wrap around within it.
  const show = (n: number) => {
    i = (n + group.length) % group.length;
    img.src = group[i].href;
    img.alt = cap.textContent = group[i].querySelector('img')?.alt ?? '';
    dlg.classList.toggle('is-single', group.length < 2);
  };
  document.addEventListener('click', (e) => {
    const a = (e.target as Element).closest<HTMLAnchorElement>('a[data-lightbox]');
    if (!a) return;
    e.preventDefault();
    group = [...(a.closest('[data-group]') ?? document).querySelectorAll<HTMLAnchorElement>('a[data-lightbox]')];
    show(group.indexOf(a));
    dlg.showModal();
  });
  dlg.querySelector('.lb__prev')!.addEventListener('click', () => show(i - 1));
  dlg.querySelector('.lb__next')!.addEventListener('click', () => show(i + 1));
  dlg.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(i - 1);
    if (e.key === 'ArrowRight') show(i + 1);
  });
  let x0 = 0;
  dlg.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
  dlg.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - x0;
    if (Math.abs(dx) > 50) show(dx < 0 ? i + 1 : i - 1);
  });
  dlg.addEventListener('click', (e) => e.target === dlg && dlg.close());
</script>

<style>
  .lb {
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 4.5rem 1rem 1.5rem;
    border: 0;
    background: rgb(255 255 255 / 0.98);
    color: var(--ink);
  }
  .lb[open] { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1rem; }
  .lb::backdrop { background: rgb(0 0 0 / 0.3); }
  .lb img { max-width: 100%; max-height: 78svh; object-fit: contain; border-radius: 0; }
  .lb__cap { max-width: 40rem; text-align: center; font-size: 0.95rem; }
  .lb__btn {
    position: absolute;
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: 999px;
    background: var(--ink);
    color: #fff;
    font: 400 1.6rem/1 var(--f-body);
    cursor: pointer;
  }
  .lb__close { top: 1rem; right: 1rem; font-size: 1.1rem; }
  .lb__prev, .lb__next { top: 50%; translate: 0 -50%; }
  .lb__prev { left: 0.75rem; }
  .lb__next { right: 0.75rem; }
  .lb.is-single :is(.lb__prev, .lb__next) { display: none; }
  .lb__btn:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; outline-offset: 3px; }
</style>
