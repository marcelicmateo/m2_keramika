---
// 11 · Radionica: the workshop — concrete, safety yellow, hazard stripes, stencil type, tape measures, toolbox labels.
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Foto from '../../designs/11/Foto.astro';
import Lightbox from '../../designs/11/Lightbox.astro';
import Ruler from '../../designs/11/Ruler.astro';
import '../../designs/11/style.css';
import hero from '../../assets/bazen.jpg';
import { url } from '../../url';

const s = (await getEntry('stranica', 'stranica'))!.data;
const { usluge } = (await getEntry('usluge', 'usluge'))!.data;
const { slike, prije_poslije } = (await getEntry('galerija', 'galerija'))!.data;
const cjenik = (await getEntry('cjenik', 'cjenik'))!.data;

const tel = `tel:${s.telefon.replace(/\s/g, '')}`;
const maps = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(s.adresa);
const grad = s.adresa.split(',').at(-1)!.trim();
const nb = (t: string) => t.replace(/ (?=(m[²¹]|cm|€)(?!\p{L}))/gu, ' ');
const dva = (n: number) => String(n).padStart(2, '0');
const nav = [['usluge', 'Usluge'], ['radovi', 'Radovi'], ['cjenik', 'Cjenik'], ['kontakt', 'Kontakt']];
const phoneIcon = 'M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z';
---
<Base>
  <div class="hazard" aria-hidden="true"></div>
  <header class="top dark">
    <div class="wrap top__in">
      <a href={url('dizajn/11/')} class="logo">{s.naziv}</a>
      <nav class="top__nav" aria-label="Odjeljci">
        {nav.map(([id, n]) => <a href={`#${id}`}>{n}</a>)}
      </nav>
      <a href={tel} class="btn btn--yellow btn--sm">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={phoneIcon} /></svg>
        <span>Nazovite</span>
      </a>
    </div>
  </header>

  <main>
    <section class="hero dark concrete">
      <div class="wrap hero__in">
        <div class="hero__text">
          <p class="tag">Keramičarski obrt · {grad}</p>
          <h1>{s.naziv}</h1>
          <p class="hero__lead">{s.slogan}</p>
          <div class="hero__cta">
            <a href={tel} class="btn btn--yellow btn--lg">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d={phoneIcon} /></svg>
              <span>{s.telefon}</span>
            </a>
            <a href={`mailto:${s.email}`} class="btn btn--line">{s.email}</a>
          </div>
        </div>
        <div class="hero__side">
          <div class="taped">
            <Image src={hero} alt="" widths={[400, 800, 1200]} sizes="(min-width: 60rem) 40vw, 92vw" quality={72} loading="eager" fetchpriority="high" />
          </div>
          <dl class="plate">
            <div><dt>Tel.</dt><dd><a href={tel}>{s.telefon}</a></dd></div>
            <div><dt>E-pošta</dt><dd><a href={`mailto:${s.email}`}>{s.email}</a></dd></div>
            <div><dt>Vlasnik</dt><dd>{s.vlasnik}</dd></div>
          </dl>
        </div>
      </div>
      <Ruler />
    </section>

    <section class="sec concrete light" aria-labelledby="uvod-h">
      <div class="wrap intro">
        <p class="tag tag--ink"><span>01</span> Uvod</p>
        <h2 id="uvod-h">{s.uvod.naslov}</h2>
        <p class="intro__text">{s.uvod.tekst}</p>
      </div>
    </section>

    <section id="usluge" class="sec concrete light sec--flush" aria-labelledby="usluge-h">
      <div class="wrap">
        <p class="tag tag--ink"><span>02</span> Usluge</p>
        <h2 id="usluge-h" class="sr">Usluge</h2>
        <ul class="drawers" role="list">
          {usluge.map((u, i) => (
            <li class="drawer">
              <p class="drawer__label"><span>Usluga {dva(i + 1)}</span><span class="drawer__handle" aria-hidden="true"></span></p>
              <div class="drawer__body">
                <h3>{u.naslov}</h3>
                <p class="drawer__lead">{u.istaknuto}</p>
                <p>{u.opis}</p>
              </div>
            </li>
          ))}
        </ul>

        <section class="warn" aria-labelledby="kval-h">
          <div class="warn__in">
            <svg class="warn__icon" viewBox="0 0 100 100" aria-hidden="true">
              <rect x="6" y="6" width="88" height="88" rx="6" />
              <path d="M27 52l16 16 31-34" class="warn__tick" />
            </svg>
            <div>
              <h2 id="kval-h">{s.kvaliteta.naslov}</h2>
              <p>{s.kvaliteta.tekst}</p>
            </div>
          </div>
        </section>
      </div>
    </section>

    <section id="radovi" class="sec dark concrete" aria-labelledby="radovi-h">
      <div class="wrap">
        <p class="tag"><span>03</span> Radovi</p>
        <h2 id="radovi-h" class="big">{s.projekti_naslov}</h2>
        <ul class="row gallery" role="list" data-group>
          {slike.map((f, i) => (
            <li class="order">
              <Foto src={f.slika} alt={f.opis} sizes="(min-width: 60rem) 280px, (min-width: 40rem) 45vw, 78vw" />
              <p><b>Nalog {dva(i + 1)}</b> {f.opis}</p>
            </li>
          ))}
        </ul>

        {prije_poslije.map((set) => {
          const koraci = [
            { label: 'Prije', src: set.prije },
            ...(set.tijekom ? [{ label: 'Tijekom', src: set.tijekom }] : []),
            { label: 'Poslije', src: set.poslije },
          ];
          return (
            <article class="set">
              <h3>{set.naslov}</h3>
              <p class="set__opis">{set.opis}</p>
              <ol class="row set__row" role="list" data-group>
                {koraci.map((k, n) => (
                  <li class="set__step">
                    <p class="tape">{dva(n + 1)} · {k.label}</p>
                    <Foto src={k.src} alt={`${k.label} – ${set.opis}`} sizes="(min-width: 60rem) 300px, (min-width: 40rem) 30vw, 72vw" />
                  </li>
                ))}
              </ol>
            </article>
          );
        })}
      </div>
    </section>

    <section id="cjenik" class="sec concrete light" aria-labelledby="cjenik-h">
      <div class="wrap">
        <p class="tag tag--ink"><span>04</span> Cjenik</p>
        <div class="sheet">
          <div class="sheet__head">
            <h2 id="cjenik-h">Cjenik*</h2>
            <a href={url('cjenik.csv')} download="cjenik-m2-keramika.csv" class="btn btn--yellow btn--sm">
              <svg viewBox="0 0 24 24" aria-hidden="true" class="stroke"><path d="M12 3v12M7 10l5 5 5-5M4 20h16" /></svg>
              <span>Preuzmite cjenik (CSV)</span>
            </a>
          </div>
          <table>
            <caption class="sr">Cjenik keramičarskih usluga</caption>
            <thead>
              <tr>
                <th scope="col">Usluga</th>
                <th scope="col">Jed.</th>
                <th scope="col" class="price">{cjenik.naslov_cijena}</th>
                {cjenik.naslov_druga_cijena && <th scope="col" class="price">{cjenik.naslov_druga_cijena}</th>}
              </tr>
            </thead>
            <tbody>
              {cjenik.stavke.map((r, i) => (
                <tr>
                  <th scope="row"><span class="pos" aria-hidden="true">{dva(i + 1)}</span>{nb(r.usluga)}</th>
                  <td class="unit">{r.jedinica}</td>
                  <td class="price" data-label={cjenik.naslov_cijena}>{nb(r.cijena)}</td>
                  {cjenik.naslov_druga_cijena && <td class="price" data-label={cjenik.naslov_druga_cijena}>{nb(r.druga_cijena ?? '–')}</td>}
                </tr>
              ))}
            </tbody>
          </table>
          <p class="sheet__note">*{cjenik.napomena}</p>
        </div>
      </div>
    </section>
  </main>

  <footer id="kontakt" class="foot dark concrete">
    <div class="hazard" aria-hidden="true"></div>
    <div class="wrap foot__in">
      <div>
        <p class="tag"><span>05</span> Kontakt</p>
        <h2 class="big">Nazovite</h2>
        <a href={tel} class="foot__tel">{s.telefon}</a>
        <p class="foot__text">{s.kontakt_tekst.trim()}</p>
      </div>
      <dl class="plate">
        <div><dt>Obrt</dt><dd>{s.naziv}</dd></div>
        <div><dt>Vlasnik</dt><dd>{s.vlasnik}</dd></div>
        <div><dt>Adresa</dt><dd><a href={maps} target="_blank" rel="noopener">{s.adresa}</a></dd></div>
        <div><dt>E-pošta</dt><dd><a href={`mailto:${s.email}`}>{s.email}</a></dd></div>
      </dl>
    </div>
    <p class="wrap foot__copy">© {new Date().getFullYear()} {s.naziv}</p>
  </footer>
  <Lightbox />
</Base>
