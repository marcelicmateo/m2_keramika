---
// 12 · Bazen: the pool world — aqua water, pool mosaic, lane ropes, soft caustic light.
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Foto from '../../designs/12/Foto.astro';
import Lightbox from '../../designs/12/Lightbox.astro';
import Caustics from '../../designs/12/Caustics.astro';
import '../../designs/12/style.css';
import hero from '../../assets/bazen.jpg';
import { url } from '../../url';

const s = (await getEntry('stranica', 'stranica'))!.data;
const { usluge } = (await getEntry('usluge', 'usluge'))!.data;
const { slike, prije_poslije } = (await getEntry('galerija', 'galerija'))!.data;
const cjenik = (await getEntry('cjenik', 'cjenik'))!.data;

const tel = `tel:${s.telefon.replace(/\s/g, '')}`;
const maps = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(s.adresa);
const grad = s.adresa.split(',').at(-1)!.trim();
const nb = (t: string) => t.replace(/ (?=(m[²¹]|cm|€)(?!\p{L}))/gu, ' ');
const nav = [['usluge', 'Usluge'], ['radovi', 'Radovi'], ['cjenik', 'Cjenik'], ['kontakt', 'Kontakt']];
const phoneIcon = 'M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z';
---
<Base>
  <header class="top">
    <div class="wrap top__in">
      <a href={url('dizajn/12/')} class="logo"><span class="logo__tile" aria-hidden="true">M²</span><span>{s.naziv}</span></a>
      <nav class="top__nav" aria-label="Odjeljci">
        {nav.map(([id, n]) => <a href={`#${id}`}>{n}</a>)}
      </nav>
      <a href={tel} class="btn btn--aqua btn--sm">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={phoneIcon} /></svg>
        <span>Nazovite</span>
      </a>
    </div>
  </header>

  <main>
    <section class="hero">
      <Image class="hero__img" src={hero} alt="" widths={[800, 1200, 1600]} sizes="100vw" quality={72} loading="eager" fetchpriority="high" />
      <Caustics id="c-hero" />
      <div class="wrap hero__text">
        <p class="chip">Keramičar · {grad}</p>
        <h1>{s.naziv}</h1>
        <p class="hero__lead">{s.slogan}</p>
        <div class="hero__cta">
          <a href={tel} class="btn btn--aqua btn--lg">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={phoneIcon} /></svg>
            <span>{s.telefon}</span>
          </a>
          <a href={`mailto:${s.email}`} class="btn btn--glass">{s.email}</a>
        </div>
      </div>
    </section>
    <div class="waterline" aria-hidden="true"></div>

    <section class="intro wrap" aria-labelledby="uvod-h">
      <h2 id="uvod-h">{s.uvod.naslov}</h2>
      <p>{s.uvod.tekst}</p>
    </section>

    <section id="usluge" class="pool" aria-labelledby="usluge-h">
      <div class="wrap">
        <h2 id="usluge-h" class="sec__h">Usluge</h2>
        <ol class="lanes" role="list">
          {usluge.map((u, i) => (
            <li class="lane">
              <span class="lane__no" aria-hidden="true">{i + 1}</span>
              <h3>{u.naslov}</h3>
              <div class="lane__text">
                <p class="lane__lead">{u.istaknuto}</p>
                <p>{u.opis}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="deep" aria-labelledby="kval-h">
      <Caustics id="c-deep" />
      <div class="wrap deep__in">
        <svg class="buoy" viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="38" class="buoy__ring" />
          <circle cx="50" cy="50" r="38" class="buoy__bands" pathLength="8" />
          <circle cx="50" cy="50" r="30" class="buoy__edge" />
          <circle cx="50" cy="50" r="46" class="buoy__edge" />
        </svg>
        <div>
          <h2 id="kval-h">{s.kvaliteta.naslov}</h2>
          <p>{s.kvaliteta.tekst}</p>
        </div>
      </div>
    </section>

    <section id="radovi" class="wrap sec" aria-labelledby="radovi-h">
      <h2 id="radovi-h" class="sec__h">{s.projekti_naslov}</h2>
      <ul class="row gallery" role="list" data-group>
        {slike.map((f) => (
          <li>
            <figure>
              <Foto src={f.slika} alt={f.opis} sizes="(min-width: 60rem) 280px, (min-width: 40rem) 45vw, 78vw" />
              <figcaption>{f.opis}</figcaption>
            </figure>
          </li>
        ))}
      </ul>

      {prije_poslije.map((set) => {
        const koraci = [
          { label: 'Prije', src: set.prije },
          ...(set.tijekom ? [{ label: 'Tijekom', src: set.tijekom }] : []),
          { label: 'Poslije', src: set.poslije },
        ];
        return (
          <article class="set">
            <div class="set__in">
              <h3>{set.naslov}</h3>
              <p class="set__opis">{set.opis}</p>
              <ol class="row set__row" role="list" data-group>
                {koraci.map((k) => (
                  <li class="set__step">
                    <p class="chip chip--ink">{k.label}</p>
                    <Foto src={k.src} alt={`${k.label} – ${set.opis}`} sizes="(min-width: 60rem) 300px, (min-width: 40rem) 30vw, 72vw" />
                  </li>
                ))}
              </ol>
            </div>
          </article>
        );
      })}
    </section>

    <section id="cjenik" class="wrap sec" aria-labelledby="cjenik-h">
      <h2 id="cjenik-h" class="sec__h">Cjenik<span aria-hidden="true">*</span></h2>
      <div class="prices">
        <table>
          <caption class="sr">Cjenik keramičarskih usluga</caption>
          <thead>
            <tr>
              <th scope="col">Usluga</th>
              <th scope="col">Jed.</th>
              <th scope="col" class="price">{cjenik.naslov_cijena}</th>
              {cjenik.naslov_druga_cijena && <th scope="col" class="price">{cjenik.naslov_druga_cijena}</th>}
            </tr>
          </thead>
          <tbody>
            {cjenik.stavke.map((r) => (
              <tr>
                <th scope="row">{nb(r.usluga)}</th>
                <td class="unit">{r.jedinica}</td>
                <td class="price" data-label={cjenik.naslov_cijena}>{nb(r.cijena)}</td>
                {cjenik.naslov_druga_cijena && <td class="price" data-label={cjenik.naslov_druga_cijena}>{nb(r.druga_cijena ?? '–')}</td>}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="prices__foot">
        <p>*{cjenik.napomena}</p>
        <a href={url('cjenik.csv')} download="cjenik-m2-keramika.csv" class="btn btn--ink">
          <svg viewBox="0 0 24 24" aria-hidden="true" class="stroke"><path d="M12 3v12M7 10l5 5 5-5M4 20h16" /></svg>
          <span>Preuzmite cjenik (CSV)</span>
        </a>
      </div>
    </section>
  </main>

  <footer id="kontakt" class="foot">
    <div class="waterline" aria-hidden="true"></div>
    <div class="wrap foot__in">
      <div>
        <p class="chip">Kontakt</p>
        <a href={tel} class="foot__tel">{s.telefon}</a>
        <a href={`mailto:${s.email}`} class="foot__mail">{s.email}</a>
        <p class="foot__text">{s.kontakt_tekst.trim()}</p>
      </div>
      <address>
        <b>{s.naziv}</b>
        <span>vl. {s.vlasnik}</span>
        <a href={maps} target="_blank" rel="noopener">{s.adresa}</a>
      </address>
    </div>
    <p class="wrap foot__copy">© {new Date().getFullYear()} {s.naziv}</p>
  </footer>
  <Lightbox />
</Base>
