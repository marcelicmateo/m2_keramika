---
// 17 · Retro 70-e — a 1970s bathroom catalogue: supergraphic stripes, arches, warm grain.
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Pic from '../../designs/17/Pic.astro';
import Lightbox from '../../designs/17/Lightbox.astro';
import bazen from '../../assets/bazen.jpg';
import { url } from '../../url';
import '../../designs/17/style.css';

const s = (await getEntry('stranica', 'stranica'))!.data;
const { usluge } = (await getEntry('usluge', 'usluge'))!.data;
const galerija = (await getEntry('galerija', 'galerija'))!.data;
const cjenik = (await getEntry('cjenik', 'cjenik'))!.data;
const set0 = galerija.prije_poslije[0];
const hero = set0 ? { src: set0.poslije, alt: `Poslije – ${set0.opis}` } : { src: bazen, alt: s.slogan };
const tel = `tel:${s.telefon.replace(/\s/g, '')}`;
const maps = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(s.adresa);
const nb = (t: string) => t.replace(/ (?=(m[²¹]|cm|€)(?!\p{L}))/gu, ' ');
const druga = cjenik.naslov_druga_cijena;
---
<Base>
  <div class="r70">
    <header class="top">
      <div class="wrap top__in">
        <a class="brand" href={url()}>{s.naziv}</a>
        <nav class="top__nav" aria-label="Sadržaj">
          <a href="#usluge">Usluge</a><a href="#radovi">Radovi</a><a href="#cjenik">Cjenik</a><a href="#kontakt">Kontakt</a>
        </nav>
        <a class="btn btn--small" href={tel}><Icon name="phone" /><span>Nazovite</span></a>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="wrap hero__in">
          <div class="hero__text">
            <p class="kicker">{s.naziv}</p>
            <h1>{s.slogan}</h1>
            <div class="actions">
              <a class="btn" href={tel}><Icon name="phone" /><span>{s.telefon}</span></a>
              <a class="btn btn--line" href={`mailto:${s.email}`}><Icon name="mail" /><span>{s.email}</span></a>
            </div>
          </div>
          <div class="arch" data-group>
            <Pic src={hero.src} alt={hero.alt} sizes="(min-width: 56rem) 420px, 80vw" eager />
          </div>
        </div>
      </section>

      <div class="bands" aria-hidden="true"></div>

      <section class="uvod wrap">
        <h2>{s.uvod.naslov}</h2>
        <p class="lead">{s.uvod.tekst}</p>
      </section>

      <section class="usluge wrap" id="usluge" aria-labelledby="usluge-h">
        <h2 id="usluge-h" class="label">Usluge</h2>
        <ol class="cards" role="list">
          {usluge.map((u, i) => (
            <li class={`card card--${i % 4}`}>
              <span class="card__no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3>{u.naslov}</h3>
              <p class="card__hi">{u.istaknuto}</p>
              <p>{u.opis}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="kvaliteta">
        <div class="wrap kvaliteta__in">
          <svg class="sun" viewBox="0 0 200 100" aria-hidden="true">
            <defs><linearGradient id="sun17" x2="0" y2="1"><stop offset="0" stop-color="#e3a62a" /><stop offset="1" stop-color="#d9622b" /></linearGradient></defs>
            <circle cx="100" cy="100" r="100" fill="url(#sun17)" />
            <g fill="#3b2314"><rect y="52" width="200" height="3" /><rect y="66" width="200" height="5" /><rect y="80" width="200" height="7" /><rect y="93" width="200" height="7" /></g>
          </svg>
          <div>
            <h2>{s.kvaliteta.naslov}</h2>
            <p class="lead">{s.kvaliteta.tekst}</p>
          </div>
        </div>
      </section>

      <section class="radovi wrap" id="radovi" aria-labelledby="radovi-h">
        <h2 id="radovi-h">{s.projekti_naslov}</h2>
        <ul class="gallery" role="list" data-group>
          {galerija.slike.map((g, i) => (
            <li>
              <Pic class="tv" src={g.slika} alt={g.opis} sizes="(min-width: 64rem) 280px, (min-width: 40rem) 45vw, 90vw" />
              <p class="cap"><b>Br. {i + 1}</b> {g.opis}</p>
            </li>
          ))}
        </ul>

        {galerija.prije_poslije.map((set) => {
          const koraci = [
            { label: 'Prije', src: set.prije },
            ...(set.tijekom ? [{ label: 'U procesu', src: set.tijekom }] : []),
            { label: 'Poslije', src: set.poslije },
          ];
          return (
            <figure class="set" data-group>
              <figcaption>
                <h3>{set.naslov}</h3>
                <p>{set.opis}</p>
              </figcaption>
              <ol class="steps" role="list">
                {koraci.map((k, i) => (
                  <li class={`step step--${i}`}>
                    <p class="step__tag">{k.label}</p>
                    <Pic class="tv" src={k.src} alt={`${k.label} – ${set.opis}`} sizes="(min-width: 64rem) 340px, (min-width: 40rem) 30vw, 75vw" />
                  </li>
                ))}
              </ol>
            </figure>
          );
        })}
      </section>

      <section class="cjenik" id="cjenik" aria-labelledby="cjenik-h">
        <div class="wrap">
          <h2 id="cjenik-h">Cjenik*</h2>
          <div class="sheet">
            <table>
              <caption class="sr">Cjenik keramičarskih usluga</caption>
              <thead>
                <tr><th scope="col">Usluga</th><th scope="col">Jed.</th><th scope="col" class="price">{cjenik.naslov_cijena}</th>{druga && <th scope="col" class="price">{druga}</th>}</tr>
              </thead>
              <tbody>
                {cjenik.stavke.map((r) => (
                  <tr>
                    <th scope="row">{nb(r.usluga)}</th>
                    <td class="unit">{r.jedinica}</td>
                    <td class="price" data-label={cjenik.naslov_cijena}>{nb(r.cijena)}</td>
                    {druga && <td class="price" data-label={druga}>{nb(r.druga_cijena ?? '–')}</td>}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="note">*{cjenik.napomena}</p>
          <a class="btn btn--line" href={url('cjenik.csv')} download="cjenik-m2-keramika.csv"><Icon name="download" /><span>Preuzmite cjenik (CSV)</span></a>
        </div>
      </section>
    </main>

    <footer class="foot" id="kontakt">
      <div class="wrap foot__in">
        <svg class="rainbow" viewBox="0 0 200 100" aria-hidden="true">
          {['#8f9b45', '#3b2314', '#e3a62a', '#3b2314', '#d9622b', '#3b2314', '#a8401a', '#3b2314', '#f6e7c9'].map((c, i) => <circle cx="100" cy="100" r={100 - i * 9} fill={c} />)}
        </svg>
        <h2>Kontakt</h2>
        <p class="foot__text">{s.kontakt_tekst.trim()}</p>
        <a class="foot__tel" href={tel}>{s.telefon}</a>
        <div class="actions">
          <a class="btn btn--sun" href={tel}><Icon name="phone" /><span>Nazovite</span></a>
          <a class="btn btn--cream" href={`mailto:${s.email}`}><Icon name="mail" /><span>{s.email}</span></a>
        </div>
        <address>
          {s.naziv}, vl. {s.vlasnik}<br />
          <a href={maps} target="_blank" rel="noopener">{s.adresa}</a>
        </address>
        <p class="copy">© {new Date().getFullYear()} {s.naziv}</p>
      </div>
    </footer>
    <Lightbox />
  </div>
</Base>
