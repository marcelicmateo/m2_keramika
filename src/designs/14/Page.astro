---
// 14 · Mozaik bento: the page is one tiled wall, every piece of content a tile, the gaps are grout.
import { getEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Foto from '../../designs/14/Foto.astro';
import Lightbox from '../../designs/14/Lightbox.astro';
import { url } from '../../url';
import logo from '../../assets/logo.png';
import bazen from '../../assets/bazen.jpg';
import '../../designs/14/style.css';

const stranica = (await getEntry('stranica', 'stranica'))!.data;
const { usluge } = (await getEntry('usluge', 'usluge'))!.data;
const galerija = (await getEntry('galerija', 'galerija'))!.data;
const cjenik = (await getEntry('cjenik', 'cjenik'))!.data;

const tel = 'tel:' + stranica.telefon.replace(/\s/g, '');
const maps = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(stranica.adresa);
const nb = (t: string) => t.replace(/ (?=(m[²¹]|cm|€)(?!\p{L}))/gu, ' ');
const druga = cjenik.naslov_druga_cijena;
---
<Base>
  <div class="mz">
    <header class="top wall">
      <a class="tile top__name" href="#vrh">{stranica.naziv}</a>
      <nav class="top__nav" aria-label="Glavna navigacija">
        <a class="tile" href="#usluge">Usluge</a><a class="tile" href="#radovi">Radovi</a><a class="tile" href="#cjenik">Cjenik</a><a class="tile" href="#kontakt">Kontakt</a>
      </nav>
      <a class="tile top__tel" href={tel}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z" /></svg>{stranica.telefon}</a>
    </header>

    <main id="vrh">
      <section class="wall hero">
        <div class="tile t-char hero__title">
          <h1>{stranica.naziv}</h1>
          <p>{stranica.slogan}</p>
        </div>
        <div class="tile hero__logo">
          <Picture src={logo} alt="" formats={['avif', 'webp']} widths={[400, 800, 1200]} sizes="(min-width: 48rem) 40vw, 100vw" />
        </div>
        <a class="tile t-terra hero__tel" href={tel}><span class="kicker">Nazovite</span><b>{stranica.telefon}</b></a>
        <a class="tile t-sand hero__mail" href={`mailto:${stranica.email}`}><span class="kicker">E-mail</span><b>{stranica.email}</b></a>
        <div class="tile deco deco--mosaic hero__d1" aria-hidden="true"></div>
        <div class="tile deco deco--cement hero__d2" aria-hidden="true"></div>
        <div class="tile t-bone hero__intro">
          <h2>{stranica.uvod.naslov}</h2>
          <p>{stranica.uvod.tekst}</p>
        </div>
        <div class="tile hero__photo">
          <Picture src={bazen} alt="" formats={['avif', 'webp']} widths={[400, 800, 1200]} sizes="(min-width: 48rem) 50vw, 100vw" />
        </div>
      </section>

      <section class="wall services" id="usluge" aria-labelledby="usluge-h">
        <div class="tile t-mustard services__label"><h2 id="usluge-h">Usluge</h2><span class="count" aria-hidden="true">{usluge.length}</span></div>
        {usluge.map((u, i) => (
          <article class={`tile svc svc--${i % 4}`}>
            <h3>{u.naslov}</h3>
            <p class="svc__hi">{u.istaknuto}</p>
            <p>{u.opis}</p>
          </article>
        ))}
        <div class="tile deco deco--penny services__d" aria-hidden="true"></div>
      </section>

      <section class="wall gallery" id="radovi" aria-labelledby="radovi-h" data-group>
        <div class="tile t-sage gallery__label"><h2 id="radovi-h">{stranica.projekti_naslov}</h2></div>
        <div class="tile t-cobalt gallery__quality">
          <h2>{stranica.kvaliteta.naslov}</h2>
          <p>{stranica.kvaliteta.tekst}</p>
        </div>
        {galerija.slike.map((s) => (
          <Foto class="gallery__ph" src={s.slika} alt={s.opis} sizes="(min-width: 48rem) 34vw, 50vw" />
        ))}
      </section>

      {galerija.prije_poslije.map((set) => {
        const koraci = [
          { label: 'Prije', src: set.prije },
          ...(set.tijekom ? [{ label: 'U procesu', src: set.tijekom }] : []),
          { label: 'Poslije', src: set.poslije },
        ];
        return (
          <section class="wall set" aria-label={set.naslov} data-group>
            <div class="tile t-bone set__head"><h3>{set.naslov}</h3><p>{set.opis}</p></div>
            <div class="tile deco deco--subway set__d" aria-hidden="true"></div>
            {koraci.map((k, i) => (
              <Foto class:list={['set__ph', i === 0 && koraci.length % 2 && 'set__ph--wide']} src={k.src} alt={`${k.label} – ${set.opis}`} sizes="(min-width: 48rem) 34vw, 100vw">
                <span class="chip">{i + 1} · {k.label}</span>
              </Foto>
            ))}
          </section>
        );
      })}

      <section class="wall prices" id="cjenik" aria-labelledby="cjenik-h">
        <div class="tile t-teal prices__head">
          <h2 id="cjenik-h">Cjenik*</h2>
          <p>*{cjenik.napomena}</p>
          <a class="btn" href={url('cjenik.csv')} download="cjenik-m2-keramika.csv"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5M4 20h16" /></svg>Preuzmite cjenik (CSV)</a>
        </div>
        <div class="tile deco deco--weave prices__d" aria-hidden="true"></div>
        <div class="tile prices__table">
          <table>
            <caption class="sr">Cjenik keramičarskih usluga</caption>
            <thead>
              <tr><th scope="col">Usluga</th><th scope="col">Jedinica</th><th scope="col" class="price">{cjenik.naslov_cijena}</th>{druga && <th scope="col" class="price">{druga}</th>}</tr>
            </thead>
            <tbody>
              {cjenik.stavke.map((s) => (
                <tr>
                  <th scope="row">{nb(s.usluga)}</th>
                  <td class="unit">{s.jedinica}</td>
                  <td class="price" data-label={cjenik.naslov_cijena}>{nb(s.cijena)}</td>
                  {druga && <td class="price" data-label={druga}>{nb(s.druga_cijena ?? '–')}</td>}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    </main>

    <footer class="wall foot" id="kontakt">
      <div class="tile t-sage foot__text"><h2>Kontakt</h2><p>{stranica.kontakt_tekst.trim()}</p></div>
      <a class="tile t-terra foot__tel" href={tel}><span class="kicker">Nazovite</span><b>{stranica.telefon}</b></a>
      <a class="tile t-char foot__mail" href={`mailto:${stranica.email}`}><span class="kicker">E-mail</span><b>{stranica.email}</b></a>
      <address class="tile t-bone foot__addr">{stranica.naziv}<br />vl. {stranica.vlasnik}<br /><a href={maps} target="_blank" rel="noopener">{stranica.adresa}</a></address>
      <div class="tile deco deco--mosaic foot__d" aria-hidden="true"></div>
      <p class="tile t-sand foot__copy">© {new Date().getFullYear()} {stranica.naziv}</p>
    </footer>
    <Lightbox />
  </div>
</Base>
