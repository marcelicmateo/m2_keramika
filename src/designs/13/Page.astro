---
// 13 · Bauhaus: primary colours, circles/squares/triangles, modular blocks, Jost.
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Foto from '../../designs/13/Foto.astro';
import Lightbox from '../../designs/13/Lightbox.astro';
import { url } from '../../url';
import '../../designs/13/style.css';

const stranica = (await getEntry('stranica', 'stranica'))!.data;
const { usluge } = (await getEntry('usluge', 'usluge'))!.data;
const galerija = (await getEntry('galerija', 'galerija'))!.data;
const cjenik = (await getEntry('cjenik', 'cjenik'))!.data;

const tel = 'tel:' + stranica.telefon.replace(/\s/g, '');
const maps = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(stranica.adresa);
const [prvo, ...ostalo] = stranica.naziv.split(' ');
const nb = (t: string) => t.replace(/ (?=(m[²¹]|cm|€)(?!\p{L}))/gu, ' ');
const nn = (i: number) => String(i + 1).padStart(2, '0');
const oblici = ['circle', 'triangle', 'square', 'half'];
const druga = cjenik.naslov_druga_cijena;
---
<Base>
  <div class="bh">
    <header class="top">
      <a class="mark" href="#vrh" aria-label={stranica.naziv}>
        <svg viewBox="0 0 66 22" aria-hidden="true"><circle cx="11" cy="11" r="11" fill="#c62a1f" /><rect x="22" width="22" height="22" fill="#111" /><path d="M44 22 55 0l11 22z" fill="#f2c00f" /></svg>
        <span>{stranica.naziv}</span>
      </a>
      <nav class="nav" aria-label="Glavna navigacija">
        <a href="#usluge">Usluge</a><a href="#radovi">Radovi</a><a href="#cjenik">Cjenik</a><a href="#kontakt">Kontakt</a>
      </nav>
      <a class="top__tel" href={tel}><span class="dot" aria-hidden="true"></span>{stranica.telefon}</a>
    </header>

    <main id="vrh">
      <section class="hero">
        <div class="hero__text">
          <h1 class="h1"><span class="h1__a">{prvo}</span> <span class="h1__b">{ostalo.join(' ')}</span></h1>
          <p class="hero__slogan">{stranica.slogan}</p>
          <div class="hero__cta">
            <a class="btn btn--red" href={tel}>Nazovite · {stranica.telefon}</a>
            <a class="btn btn--line" href={`mailto:${stranica.email}`}>{stranica.email}</a>
          </div>
        </div>
        <div class="comp" aria-hidden="true">
          {Array.from({ length: 9 }, (_, i) => <i class={`t t${i + 1}`}><b></b></i>)}
          <span class="comp__bar"></span>
        </div>
      </section>

      <section class="intro wrap">
        <div class="intro__art" aria-hidden="true"><i></i><b></b></div>
        <div>
          <h2 class="h2">{stranica.uvod.naslov}</h2>
          <p class="lead">{stranica.uvod.tekst}</p>
        </div>
      </section>

      <section class="services wrap" id="usluge" aria-labelledby="usluge-h">
        <h2 class="label" id="usluge-h"><span class="label__n">01</span>Usluge</h2>
        <ul class="cards" role="list">
          {usluge.map((u, i) => (
            <li class={`card card--${i % 4}`}>
              <svg class="card__shape" viewBox="0 0 40 40" aria-hidden="true">
                {oblici[i % 4] === 'circle' && <circle cx="20" cy="20" r="20" />}
                {oblici[i % 4] === 'triangle' && <path d="M0 40 20 0l20 40z" />}
                {oblici[i % 4] === 'square' && <rect width="40" height="40" />}
                {oblici[i % 4] === 'half' && <path d="M0 40a20 20 0 0 1 40 0z" />}
              </svg>
              <p class="card__n">{nn(i)}</p>
              <h3>{u.naslov}</h3>
              <p class="card__hi">{u.istaknuto}</p>
              <p>{u.opis}</p>
            </li>
          ))}
        </ul>
      </section>

      <section class="quality">
        <div class="wrap quality__in">
          <h2 class="h2">{stranica.kvaliteta.naslov}</h2>
          <p class="lead">{stranica.kvaliteta.tekst}</p>
        </div>
        <i class="quality__c" aria-hidden="true"></i><i class="quality__s" aria-hidden="true"></i>
      </section>

      <section class="work wrap" id="radovi" aria-labelledby="radovi-h">
        <h2 class="label" id="radovi-h"><span class="label__n">02</span>{stranica.projekti_naslov}</h2>
        <ul class="gallery" role="list" data-group>
          {galerija.slike.map((s, i) => (
            <li><Foto src={s.slika} alt={s.opis} sizes="(min-width: 75rem) 290px, (min-width: 48rem) 25vw, 50vw" /><span class="gallery__n" aria-hidden="true">{nn(i)}</span></li>
          ))}
        </ul>

        {galerija.prije_poslije.map((set) => {
          const koraci = [
            { label: 'Prije', src: set.prije },
            ...(set.tijekom ? [{ label: 'U procesu', src: set.tijekom }] : []),
            { label: 'Poslije', src: set.poslije },
          ];
          return (
            <figure class="set">
              <figcaption class="set__head"><h3>{set.naslov}</h3><p>{set.opis}</p></figcaption>
              <ol class="steps" role="list" data-group>
                {koraci.map((k, i) => (
                  <li class={`step step--${i}`}>
                    <p class="step__label"><span>{i + 1}</span>{k.label}</p>
                    <Foto src={k.src} alt={`${k.label} – ${set.opis}`} sizes="(min-width: 75rem) 380px, (min-width: 48rem) 31vw, 78vw" />
                  </li>
                ))}
              </ol>
            </figure>
          );
        })}
      </section>

      <section class="prices wrap" id="cjenik" aria-labelledby="cjenik-h">
        <div class="prices__side">
          <h2 class="label" id="cjenik-h"><span class="label__n">03</span>Cjenik*</h2>
          <p class="note">*{cjenik.napomena}</p>
          <a class="btn btn--blue" href={url('cjenik.csv')} download="cjenik-m2-keramika.csv">↓ Preuzmite cjenik (CSV)</a>
          <svg class="prices__art" viewBox="0 0 120 120" aria-hidden="true"><path d="M0 120 60 0l60 120z" fill="#f2c00f" /><circle cx="60" cy="84" r="26" fill="#c62a1f" /></svg>
        </div>
        <table class="table">
          <caption class="sr">Cjenik keramičarskih usluga</caption>
          <thead>
            <tr><th scope="col">Usluga</th><th scope="col">Jed.</th><th scope="col" class="price">{cjenik.naslov_cijena}</th>{druga && <th scope="col" class="price">{druga}</th>}</tr>
          </thead>
          <tbody>
            {cjenik.stavke.map((s) => (
              <tr>
                <th scope="row">{nb(s.usluga)}</th>
                <td class="unit"><span>{s.jedinica}</span></td>
                <td class="price" data-label={cjenik.naslov_cijena}>{nb(s.cijena)}</td>
                {druga && <td class="price" data-label={druga}>{nb(s.druga_cijena ?? '–')}</td>}
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    </main>

    <footer class="foot" id="kontakt">
      <div class="wrap foot__grid">
        <div>
          <h2 class="label label--light"><span class="label__n">04</span>Kontakt</h2>
          <p class="foot__text">{stranica.kontakt_tekst.trim()}</p>
        </div>
        <div class="foot__links">
          <a class="foot__tel" href={tel}><span>Nazovite</span>{stranica.telefon}</a>
          <a class="foot__mail" href={`mailto:${stranica.email}`}>{stranica.email}</a>
          <address>{stranica.naziv}, vl. {stranica.vlasnik}<br /><a href={maps} target="_blank" rel="noopener">{stranica.adresa}</a></address>
        </div>
      </div>
      <div class="foot__band" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
      <p class="wrap foot__copy">© {new Date().getFullYear()} {stranica.naziv}</p>
    </footer>
    <Lightbox />
  </div>
</Base>
