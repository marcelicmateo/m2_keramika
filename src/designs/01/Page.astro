---
// 01 · Švicarski grid — International Typographic Style: 12-column grid, Inter, black/white + signal red.
import { getEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Shot from '../../designs/01/Shot.astro';
import Lightbox from '../../designs/01/Lightbox.astro';
import hero from '../../assets/bazen.jpg';
import { url } from '../../url';
import '../../designs/01/style.css';

const s = (await getEntry('stranica', 'stranica'))!.data;
const { usluge } = (await getEntry('usluge', 'usluge'))!.data;
const galerija = (await getEntry('galerija', 'galerija'))!.data;
const cjenik = (await getEntry('cjenik', 'cjenik'))!.data;

const tel = `tel:${s.telefon.replace(/\s/g, '')}`;
const maps = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(s.adresa);
const nn = (i: number) => String(i + 1).padStart(2, '0');
const nb = (t: string) => t.replace(/ (?=(m[²¹]|cm|€)(?!\p{L}))/gu, ' ');
// "30 €" is set as a big numeral; free-text prices ("⅓ cijene …") stay at text size.
const price = (t: string) => /^\d+([.,]\d+)?\s*€$/.test(t.trim()) ? { big: t.replace(/\s*€$/, ''), unit: '€' } : null;
const druga = cjenik.naslov_druga_cijena;
const sizes = '(min-width: 64rem) 25vw, 50vw';
---
<Base>
  <header class="top">
    <div class="g top__in">
      <a class="top__brand" href={url('dizajn/01/')}>M²&nbsp;Keramika</a>
      <nav class="top__nav" aria-label="Sadržaj">
        <a href="#usluge">Usluge</a>
        <a href="#radovi">Radovi</a>
        <a href="#cjenik">Cjenik</a>
        <a href="#kontakt">Kontakt</a>
      </nav>
      <a class="top__tel" href={tel}><span class="top__tel-l">Nazovite</span> {s.telefon}</a>
    </div>
  </header>

  <main>
    <section class="hero g" aria-labelledby="naslov">
      <p class="hero__mark" aria-hidden="true">M<sup>2</sup></p>
      <div class="hero__text">
        <p class="kicker">Keramičar · {s.adresa.split(',').pop()?.trim()}</p>
        <h1 id="naslov" class="hero__title">{s.slogan}</h1>
        <ul class="hero__list" role="list">
          {usluge.map((u, i) => <li><span>{nn(i)}</span>{u.naslov}</li>)}
        </ul>
      </div>
      <div class="hero__cta">
        <a class="bigtel" href={tel}><span class="kicker">Nazovite</span>{s.telefon}</a>
        <a class="mail" href={`mailto:${s.email}`}>{s.email}</a>
      </div>
      <div class="hero__img">
        <Picture src={hero} alt="" formats={['avif', 'webp']} widths={[800, 1200, 1600]} sizes="100vw" loading="eager" />
      </div>
    </section>

    <section class="sec g" aria-labelledby="uvod">
      <p class="sec__label"><span>01</span> Uvod</p>
      <h2 id="uvod" class="sec__title">{s.uvod.naslov}</h2>
      <p class="sec__body lead">{s.uvod.tekst}</p>
    </section>

    <section class="sec g" id="usluge" aria-labelledby="usluge-h">
      <p class="sec__label"><span>02</span> Usluge</p>
      <h2 id="usluge-h" class="sec__title">Usluge</h2>
      <ol class="services" role="list">
        {usluge.map((u, i) => (
          <li class="svc">
            <span class="svc__n" aria-hidden="true">{nn(i)}</span>
            <h3 class="svc__t">{u.naslov}</h3>
            <p class="svc__k">{u.istaknuto}</p>
            <p class="svc__d">{u.opis}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="sec sec--black g" aria-labelledby="kvaliteta">
      <p class="sec__label"><span>03</span> Kvaliteta</p>
      <h2 id="kvaliteta" class="sec__title sec__title--xl">{s.kvaliteta.naslov}</h2>
      <p class="sec__body lead">{s.kvaliteta.tekst}</p>
    </section>

    <section class="sec g" id="radovi" aria-labelledby="radovi-h">
      <p class="sec__label"><span>04</span> Radovi</p>
      <h2 id="radovi-h" class="sec__title">{s.projekti_naslov}</h2>
      <ul class="gallery" role="list" data-group>
        {galerija.slike.map((g, i) => (
          <li>
            <figure>
              <Shot src={g.slika} alt={g.opis} sizes={sizes} />
              <figcaption><b>{nn(i)}</b> {g.opis}</figcaption>
            </figure>
          </li>
        ))}
      </ul>

      {galerija.prije_poslije.map((set) => {
        const koraci = [
          { label: 'Prije', src: set.prije },
          ...(set.tijekom ? [{ label: 'U procesu', src: set.tijekom }] : []),
          { label: 'Poslije', src: set.poslije },
        ];
        return (
          <figure class="set" data-group>
            <figcaption class="set__head">
              <h3 class="set__t">{set.naslov}</h3>
              <p>{set.opis}</p>
            </figcaption>
            <ol class="set__steps" role="list" style={`--n:${koraci.length}`}>
              {koraci.map((k, i) => (
                <li>
                  <p class="set__l"><b>{String.fromCharCode(65 + i)}</b> {k.label}</p>
                  <Shot src={k.src} alt={`${k.label} – ${set.opis}`} sizes="(min-width: 64rem) 30vw, 72vw" />
                </li>
              ))}
            </ol>
          </figure>
        );
      })}
    </section>

    <section class="sec g" id="cjenik" aria-labelledby="cjenik-h">
      <p class="sec__label"><span>05</span> Cjenik</p>
      <h2 id="cjenik-h" class="sec__title">Cjenik*</h2>
      <table class="prices">
        <caption class="visually-hidden">Cjenik keramičarskih usluga</caption>
        <thead>
          <tr>
            <th scope="col" class="p-n">Br.</th>
            <th scope="col">Usluga</th>
            <th scope="col" class="p-u">Jed.</th>
            <th scope="col" class="p-c">{cjenik.naslov_cijena}</th>
            {druga && <th scope="col" class="p-c">{druga}</th>}
          </tr>
        </thead>
        <tbody>
          {cjenik.stavke.map((r, i) => (
            <tr>
              <td class="p-n">{nn(i)}</td>
              <th scope="row">{nb(r.usluga)}</th>
              <td class="p-u">{r.jedinica}</td>
              {[r.cijena, ...(druga ? [r.druga_cijena ?? '–'] : [])].map((c, j) => {
                const p = price(c);
                return (
                  <td class="p-c" data-label={j ? druga : cjenik.naslov_cijena}>
                    {p ? <><span class="num">{p.big}</span>&nbsp;{p.unit}</> : nb(c)}
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
      <div class="prices__foot">
        <p class="note">*{cjenik.napomena}</p>
        <a class="btn" href={url('cjenik.csv')} download="cjenik-m2-keramika.csv">↓ Preuzmite cjenik (CSV)</a>
      </div>
    </section>
  </main>

  <footer class="foot g" id="kontakt" aria-labelledby="kontakt-h">
    <p class="sec__label"><span>06</span> Kontakt</p>
    <h2 id="kontakt-h" class="visually-hidden">Kontakt</h2>
    <p class="foot__text">{s.kontakt_tekst.trim()}</p>
    <a class="foot__tel" href={tel}>{s.telefon}</a>
    <dl class="foot__dl">
      <div><dt>E-pošta</dt><dd><a href={`mailto:${s.email}`}>{s.email}</a></dd></div>
      <div><dt>Vlasnik</dt><dd>{s.vlasnik}</dd></div>
      <div><dt>Adresa</dt><dd><a href={maps} target="_blank" rel="noopener">{s.adresa}</a></dd></div>
      <div><dt>Obrt</dt><dd>{s.naziv} © {new Date().getFullYear()}</dd></div>
    </dl>
  </footer>
  <Lightbox />
</Base>
