---
// 06 · Mediteran: Zadar limestone, Adriatic blue, terracotta and olive; arches, waves and the sun. Fraunces + DM Sans.
import { getEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Photo from '../../designs/06/Photo.astro';
import Lightbox from '../../designs/06/Lightbox.astro';
import Icon from '../../designs/06/Icon.astro';
import hero from '../../assets/bazen.jpg';
import { url } from '../../url';
import '../../designs/06/style.css';

const s = (await getEntry('stranica', 'stranica'))!.data;
const { usluge } = (await getEntry('usluge', 'usluge'))!.data;
const galerija = (await getEntry('galerija', 'galerija'))!.data;
const cjenik = (await getEntry('cjenik', 'cjenik'))!.data;

const tel = `tel:${s.telefon.replace(/\s/g, '')}`;
const grad = s.adresa.split(',').pop()!.trim();
const maps = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(s.adresa);
const nb = (t: string) => t.replace(/ (?=(m[²¹]|cm|€)(?!\p{L}))/gu, ' ');
const druga = cjenik.naslov_druga_cijena;
const ikone = ['tiles', 'level', 'drop', 'sill'] as const;
const boje = ['terra', 'sea', 'olive', 'sun'];
const wave = 'M0 32C160 8 320 8 480 26S800 52 960 34 1280 6 1440 24V64H0Z';
---
<Base>
  <header class="top">
    <div class="wrap top__in">
      <a class="brand" href="#vrh">{s.naziv}<span>{grad}</span></a>
      <nav class="top__nav" aria-label="Sekcije">
        <a href="#usluge">Usluge</a><a href="#radovi">Radovi</a><a href="#cjenik">Cjenik</a><a href="#kontakt">Kontakt</a>
      </nav>
      <a class="btn btn--sea btn--sm" href={tel}><Icon name="phone" /><span>Nazovite</span></a>
    </div>
  </header>

  <main id="vrh">
    <section class="hero wrap" aria-labelledby="h1">
      <div class="hero__text">
        <p class="eyebrow">{s.naziv} · {grad}</p>
        <h1 id="h1">{s.slogan}</h1>
        <ul class="chips" role="list">{usluge.map((u) => <li>{u.naslov}</li>)}</ul>
        <div class="cta">
          <a class="btn btn--sea" href={tel}><Icon name="phone" />{s.telefon}</a>
          <a class="btn btn--line" href={`mailto:${s.email}`}><Icon name="mail" />{s.email}</a>
        </div>
      </div>
      <div class="hero__art">
        <span class="sun" aria-hidden="true"></span>
        <Picture class="arch" src={hero} alt="" formats={['avif', 'webp']} widths={[400, 800, 1200]} sizes="(min-width: 56rem) 34vw, 80vw" loading="eager" fetchpriority="high" />
        <span class="cotto" aria-hidden="true"></span>
      </div>
    </section>

    <section class="intro wrap" aria-labelledby="uvod">
      <svg class="branch" viewBox="0 0 160 44" aria-hidden="true">
        <path d="M8 34C46 26 104 24 152 8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        <g fill="currentColor">
          <ellipse cx="34" cy="24" rx="11" ry="4" transform="rotate(-32 34 24)" />
          <ellipse cx="44" cy="35" rx="11" ry="4" transform="rotate(18 44 35)" />
          <ellipse cx="74" cy="18" rx="11" ry="4" transform="rotate(-38 74 18)" />
          <ellipse cx="84" cy="31" rx="11" ry="4" transform="rotate(10 84 31)" />
          <ellipse cx="114" cy="12" rx="11" ry="4" transform="rotate(-44 114 12)" />
          <ellipse cx="124" cy="24" rx="10" ry="4" transform="rotate(4 124 24)" />
        </g>
        <circle cx="100" cy="34" r="5" fill="var(--sea)" />
      </svg>
      <h2 id="uvod">{s.uvod.naslov}</h2>
      <p>{s.uvod.tekst}</p>
    </section>

    <section class="services wrap" id="usluge" aria-labelledby="usluge-h">
      <h2 class="kicker" id="usluge-h">Usluge</h2>
      <div class="cards">
        {usluge.map((u, i) => (
          <article class={`card card--${boje[i % 4]}`}>
            <div class="card__niche"><Icon name={ikone[i % 4]} /></div>
            <h3>{u.naslov}</h3>
            <p class="card__hi">{u.istaknuto}</p>
            <p>{u.opis}</p>
          </article>
        ))}
      </div>
    </section>

    <svg class="wave" viewBox="0 0 1440 64" preserveAspectRatio="none" aria-hidden="true"><path d={wave} /></svg>
    <section class="sea" aria-labelledby="kvaliteta">
      <div class="wrap sea__in">
        <h2 id="kvaliteta">{s.kvaliteta.naslov}</h2>
        <p>{s.kvaliteta.tekst}</p>
      </div>
    </section>
    <svg class="wave wave--down" viewBox="0 0 1440 64" preserveAspectRatio="none" aria-hidden="true"><path d={wave} /></svg>

    <section class="works wrap" id="radovi" aria-labelledby="radovi-h">
      <p class="kicker" aria-hidden="true">Radovi</p>
      <h2 id="radovi-h">{s.projekti_naslov}</h2>
      <ul class="arcade" role="list" data-group>
        {galerija.slike.map((p) => (
          <li>
            <Photo class="ph" src={p.slika} alt={p.opis} sizes="(min-width: 56rem) 22vw, 44vw" />
            <p>{p.opis}</p>
          </li>
        ))}
      </ul>

      {galerija.prije_poslije.map((set) => {
        const koraci = [
          { label: 'Prije', src: set.prije },
          ...(set.tijekom ? [{ label: 'Tijekom', src: set.tijekom }] : []),
          { label: 'Poslije', src: set.poslije },
        ];
        return (
          <figure class="set" data-group>
            <figcaption><h3>{set.naslov}</h3><p>{set.opis}</p></figcaption>
            <ol class="set__row" role="list">
              {koraci.map((k) => (
                <li>
                  <Photo class="ph" src={k.src} alt={`${k.label} – ${set.opis}`} sizes="(min-width: 56rem) 20vw, 30vw" />
                  <p class="set__label">{k.label}</p>
                </li>
              ))}
            </ol>
          </figure>
        );
      })}
    </section>

    <section class="prices wrap" id="cjenik" aria-labelledby="cjenik-h">
      <div class="prices__card">
        <h2 id="cjenik-h">Cjenik<span aria-hidden="true">*</span></h2>
        <table class="pl">
          <caption class="vh">Cjenik keramičarskih usluga</caption>
          <thead>
            <tr><th scope="col">Usluga</th><th scope="col">Jedinica</th><th scope="col" class="num">{cjenik.naslov_cijena}</th>{druga && <th scope="col" class="num">{druga}</th>}</tr>
          </thead>
          <tbody>
            {cjenik.stavke.map((r) => (
              <tr>
                <th scope="row">{nb(r.usluga)}</th>
                <td class="unit"><span>{r.jedinica}</span></td>
                <td class="num" data-label={cjenik.naslov_cijena}>{nb(r.cijena)}</td>
                {druga && <td class="num" data-label={druga}>{nb(r.druga_cijena ?? '–')}</td>}
              </tr>
            ))}
          </tbody>
        </table>
        <p class="note">*{cjenik.napomena}</p>
        <a class="btn btn--line" href={url('cjenik.csv')} download="cjenik-m2-keramika.csv"><Icon name="download" />Preuzmite cjenik (CSV)</a>
      </div>
    </section>
  </main>

  <svg class="wave wave--foot" viewBox="0 0 1440 64" preserveAspectRatio="none" aria-hidden="true"><path d={wave} /></svg>
  <footer class="foot" id="kontakt" aria-labelledby="kontakt-h">
    <div class="wrap foot__in">
      <div>
        <h2 id="kontakt-h">Kontakt</h2>
        <p class="foot__txt">{s.kontakt_tekst.trim()}</p>
      </div>
      <div class="foot__links">
        <a class="foot__tel" href={tel}><Icon name="phone" />{s.telefon}</a>
        <a href={`mailto:${s.email}`}><Icon name="mail" />{s.email}</a>
        <a href={maps} target="_blank" rel="noopener"><Icon name="pin" />{s.adresa}</a>
        <p class="foot__owner">{s.naziv}, vl. {s.vlasnik}</p>
      </div>
    </div>
    <p class="wrap foot__copy">© {new Date().getFullYear()} {s.naziv}</p>
  </footer>
  <Lightbox />
</Base>
