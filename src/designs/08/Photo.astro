---
// A photo that opens in the lightbox (or the large image without JS). Styled by the design's CSS.
import type { ImageMetadata } from 'astro';
import { Picture, getImage } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  class?: string;
}
const { src, alt, sizes, class: cls } = Astro.props;
const large = await getImage({ src, width: src.width >= 1600 ? 1600 : 1200, format: 'webp' });
---
<a class={cls} href={large.src} data-lightbox>
  <Picture src={src} alt={alt} formats={['avif', 'webp']} widths={[400, 800, 1200]} sizes={sizes} loading="lazy" decoding="async" />
</a>
