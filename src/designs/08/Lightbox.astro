<dialog id="lb" class="lb" aria-label="Uvećana fotografija">
  <figure class="lb__fig">
    <img alt="" />
    <figcaption><span class="lb__count" data-count></span> <span data-cap></span></figcaption>
  </figure>
  <form method="dialog"><button class="lb__btn lb__close" aria-label="Zatvori">✕</button></form>
  <button class="lb__btn lb__nav lb__nav--prev" type="button" aria-label="Prethodna fotografija" data-prev>‹</button>
  <button class="lb__btn lb__nav lb__nav--next" type="button" aria-label="Sljedeća fotografija" data-next>›</button>
</dialog>

<script>
  const dlg = document.getElementById('lb') as HTMLDialogElement;
  const img = dlg.querySelector('img')!;
  const cap = dlg.querySelector('[data-cap]')!;
  const count = dlg.querySelector('[data-count]')!;
  const pad = (n: number) => String(n).padStart(2, '0');
  let group: HTMLAnchorElement[] = [];
  let i = 0;

  // Show photo n of the current group (the row the clicked photo belongs to), wrapping around.
  const show = (n: number) => {
    i = (n + group.length) % group.length;
    img.src = group[i].href;
    img.alt = cap.textContent = group[i].querySelector('img')?.alt ?? '';
    count.textContent = `${pad(i + 1)} / ${pad(group.length)}`;
    dlg.classList.toggle('is-single', group.length < 2);
  };

  document.addEventListener('click', (e) => {
    const a = (e.target as Element).closest<HTMLAnchorElement>('a[data-lightbox]');
    if (!a) return;
    e.preventDefault();
    group = [...(a.closest('[data-group]') ?? document).querySelectorAll<HTMLAnchorElement>('a[data-lightbox]')];
    show(group.indexOf(a));
    dlg.showModal();
  });

  dlg.querySelector('[data-prev]')!.addEventListener('click', () => show(i - 1));
  dlg.querySelector('[data-next]')!.addEventListener('click', () => show(i + 1));
  dlg.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(i - 1);
    if (e.key === 'ArrowRight') show(i + 1);
  });
  let x0 = 0;
  dlg.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
  dlg.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - x0;
    if (Math.abs(dx) > 50) show(dx < 0 ? i + 1 : i - 1);
  });
  dlg.addEventListener('click', (e) => {
    if (e.target === dlg) dlg.close();
  });
</script>
