---
// A work photo that opens in the lightbox (or the large image without JS).
import type { ImageMetadata } from 'astro';
import { Picture, getImage } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
}
const { src, alt, sizes } = Astro.props;
const large = await getImage({ src, width: Math.min(1600, src.width), format: 'webp' });
---
<a class="shot" href={large.src} data-lightbox>
  <Picture src={src} alt={alt} formats={['avif', 'webp']} widths={[400, 800, 1200]} sizes={sizes} loading="lazy" decoding="async" />
</a>
